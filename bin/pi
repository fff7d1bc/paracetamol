#!/bin/sh
set -eu

self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case "$link" in
        /*) self=$link ;;
        *) self=$(dirname -- "$self")/$link ;;
    esac
done
project_root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd -P)
exec "$project_root/paracetamol" agent run pi -- "$@"
