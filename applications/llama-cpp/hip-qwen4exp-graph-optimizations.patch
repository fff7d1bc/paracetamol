+// Aged unified caches can reach block 0xFFFF without filling the live token
+// pool. Exercise that block and padded descriptors against an independent
+// constant-row oracle, keeping CPU work proportional to the selected set.
+struct test_qsa_end_block : public test_case {
+    const int keys;
+    const bool maskless;
+    static constexpr int queries = 513, dim = 256, heads = 12, selected = 9;
+    ggml_tensor * q = nullptr, * k = nullptr, * v = nullptr, * mask = nullptr, * ids = nullptr;
+    test_qsa_end_block(int keys, bool maskless) : keys(keys), maskless(maskless) {}
+    std::string op_desc(ggml_tensor *) override { return "QSA_END_BLOCK"; }
+    std::string vars() override { return VARS_TO_STR2(keys, maskless); }
+    bool run_whole_graph() override { return true; }
+    double max_nmse_err() override { return 5e-4; }
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        q = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, dim, queries, heads, 1);
+        k = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, dim, keys, 1, 1);
+        v = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, dim, keys, 1, 1);
+        mask = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, keys, queries, 1, 1);
+        ids = ggml_new_tensor_4d(ctx, GGML_TYPE_I32, selected, queries, 1, 1);
+        auto * out = ggml_flash_attn_ext(ctx, q, k, v, maskless ? nullptr : mask,
+                1.0f/sqrtf(dim), 0.0f, 0.0f);
+        ggml_flash_attn_ext_add_top_k(out, ids, 0);
+        ggml_flash_attn_ext_set_top_k_mask(out);
+        ggml_prec_set_acc(out, GGML_PREC_F32);
+        return out;
+    }
+    void initialize_tensors(ggml_context *) override {
+        for (auto * t : {q, k, v}) ggml_backend_tensor_memset(t, 0, 0, ggml_nbytes(t));
+        std::vector<ggml_fp16_t> row(dim);
+        // The union has two real blocks and two padding descriptors. Poison
+        // block zero so padding must suppress values before any arithmetic.
+        for (int key : {0, keys-3}) {
+            std::fill(row.begin(), row.end(), ggml_fp32_to_fp16(NAN));
+            ggml_backend_tensor_set(v, row.data(), size_t(key)*v->nb[1], dim*sizeof(ggml_fp16_t));
+        }
+        for (int offset : {8, 4, 2, 1}) {
+            std::fill(row.begin(), row.end(), ggml_fp32_to_fp16(float(offset)/8.0f));
+            ggml_backend_tensor_set(v, row.data(), size_t(keys-offset)*v->nb[1], dim*sizeof(ggml_fp16_t));
+        }
+        std::vector<int32_t> picks(ggml_nelements(ids));
+        // A broad mask makes IDs authoritative, rather than a redundant hint.
+        std::vector<ggml_fp16_t> masks(ggml_nelements(mask), ggml_fp32_to_fp16(0.0f));
+        for (int query=0; query<queries; ++query) {
+            const int32_t row_ids[selected] = {keys-4, keys-1, keys-4, keys-8,
+                -1, keys+1, maskless ? -1 : keys-3, query%2 ? keys-2 : -1, keys-8};
+            std::copy(row_ids, row_ids+selected, picks.begin()+size_t(query)*selected);
+            masks[size_t(query)*keys+keys-3] = ggml_fp32_to_fp16(-INFINITY);
+            masks[size_t(query)*keys+keys-1] = ggml_fp32_to_fp16(0.125f);
+        }
+        ggml_backend_tensor_set(ids, picks.data(), 0, ggml_nbytes(ids));
+        ggml_backend_tensor_set(mask, masks.data(), 0, ggml_nbytes(mask));
+    }
+    double err(const float * actual, const float * cpu, size_t n) override {
+        std::vector<float> reference(n);
+        for (int query=0; query<queries; ++query) {
+            const double weight = maskless ? 1.0 : std::exp(0.125);
+            const double extra = query%2 ? 1.0 : 0.0;
+            const float expected = float((0.5 + 0.125*weight + 1.0 + 0.25*extra)/(2.0 + weight + extra));
+            for (int head=0; head<heads; ++head) for (int d=0; d<dim; ++d) {
+                reference[d+size_t(dim)*(head+heads*query)] = expected;
+            }
+        }
+        // Require both implementations to agree with the independently known
+        // softmax; matching the same wrong low-block alias cannot pass.
+        for (size_t i=0; i<n; ++i) if (!std::isfinite(actual[i]) || !std::isfinite(cpu[i])) return INFINITY;
+        return std::max(nmse(reference.data(), actual, n), nmse(reference.data(), cpu, n));
+    }
+};
+
+// A broad causal mask must not make unselected rows visible. Compare the
+// explicit intersection against an independently materialized selected mask.
+struct test_qsa_intersection : public test_qsa_prefill {
+    ggml_tensor * broad = nullptr;
+    test_qsa_intersection(int queries, int selected, int ratio=12)
+        : test_qsa_prefill(queries, 4096, selected, true, true, 1, ratio) {}
+    std::string op_desc(ggml_tensor *) override { return "QSA_INTERSECTION"; }
+    double max_nmse_err() override { return 0; }
+    double err(const float * actual, const float * cpu, size_t n) override {
+        for (size_t i=0; i<n; ++i) {
+            if (actual[i]!=0.0f || cpu[i]!=0.0f) return INFINITY;
+        }
+        return 0;
+    }
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        auto * reference = test_qsa_prefill::build_graph(ctx);
+        broad = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, keys, queries, 1, 1);
+        auto * sparse = ggml_flash_attn_ext(ctx, q, k, v, broad, 1.0f/sqrtf(dim), 0.0f, 0.0f);
+        ggml_flash_attn_ext_add_top_k(sparse, ids, 0);
+        ggml_flash_attn_ext_set_top_k_mask(sparse);
+        ggml_prec_set_acc(sparse, GGML_PREC_F32);
+        return ggml_sub(ctx, reference, sparse);
+    }
+    void initialize_tensors(ggml_context * ctx) override {
+        test_qsa_prefill::initialize_tensors(ctx);
+        std::vector<ggml_fp16_t> values(ggml_nelements(broad));
+        for (int query=0; query<queries; ++query) for (int key=0; key<keys; ++key) {
+            values[size_t(query)*keys+key] = ggml_fp32_to_fp16(
+                    key==3 ? -INFINITY : 0.015625f*(key%5-2));
+        }
+        ggml_backend_tensor_set(broad, values.data(), 0, ggml_nbytes(broad));
+    }
+};
