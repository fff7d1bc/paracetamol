+// A compact visibility record is valid only for a unique scalar prefix owned
+// by one sequence. Never approximate a shared, gapped, or multimodal cache.
+inline bool qwen4exp_qsa_prefix_valid(const llama_kv_cells & cells, const llama_ubatch & u, uint32_t n_kv) {
+    if (!u.token || !u.pos || !u.n_pos || !u.n_tokens || !u.n_seq_id || !u.seq_id ||
