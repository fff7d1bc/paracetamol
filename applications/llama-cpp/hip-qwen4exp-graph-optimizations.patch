diff --git a/ggml/src/ggml-cuda/qwen4exp-mmq.cu b/ggml/src/ggml-cuda/qwen4exp-mmq.cu
new file mode 100644
index 000000000..6104e805b
--- /dev/null
+++ b/ggml/src/ggml-cuda/qwen4exp-mmq.cu
@@ -0,0 +1,20 @@
+#include "mmq.cuh"
+
+// The Strix fork favors smaller row tiles for these expert types. Use the
+// existing upstream J32/I64 kernels instead of changing global tile tables.
+// Only explicitly hinted Qwen4exp operations reach this optional path.
+bool ggml_cuda_mmq_small_moe(ggml_backend_cuda_context & ctx, const mmq_args & a, cudaStream_t stream) {
+#if defined(GGML_USE_HIP)
+    const char * enabled = getenv("PARACETAMOL_QWEN4EXP_MMQ_TILES");
+    if ((enabled && strcmp(enabled, "0") == 0) || !a.ids_dst || a.nrows_x % 128 || a.ncols_max < 256 ||
+            ggml_cuda_info().devices[ctx.device].cc != GGML_CUDA_CC_OFFSET_AMD + 0x1151) return false;
+    switch (a.type_x) {
+        case GGML_TYPE_Q4_K: launch_mul_mat_q<GGML_TYPE_Q4_K, 32, false>(ctx, a, stream); return true;
+        case GGML_TYPE_Q5_1: launch_mul_mat_q<GGML_TYPE_Q5_1, 32, false>(ctx, a, stream); return true;
+        default: break;
+    }
+#else
+    GGML_UNUSED(ctx); GGML_UNUSED(a); GGML_UNUSED(stream);
+#endif
+    return false;
+}
diff --git a/ggml/src/ggml-cuda/qwen4exp-mmv.cu b/ggml/src/ggml-cuda/qwen4exp-mmv.cu
new file mode 100644
index 000000000..1183af5e7
--- /dev/null
+++ b/ggml/src/ggml-cuda/qwen4exp-mmv.cu
@@ -0,0 +1,117 @@
+// Q8-only extraction from halo-box/strix-llama.cpp, MIT,
+// 7a9196dad8b13b70fb3420886aadaf98fc09b849. No BF16 shadow weights or residuals.
+#include "qwen4exp-mmv.cuh"
+#include "vecdotq.cuh"
+#if defined(GGML_USE_HIP)
+
+template<int Prefetch>
+struct qwen_q8_chunk {
+    int qs[Prefetch][VDR_Q8_0_Q8_1_MMVQ];
+    half d[Prefetch];
+};
+
+template<int Prefetch>
+static __device__ __forceinline__ void qwen_q8_load(qwen_q8_chunk<Prefetch> & c,
+        const block_q8_0 * __restrict__ weights, int first, int offset, int blocks) {
+    constexpr int step = VDR_Q8_0_Q8_1_MMVQ*32/QI8_0;
+#pragma unroll
+    for (int i=0;i<Prefetch;++i) {
+        const int block=first+i*step;
+        if (block<blocks) {
+#pragma unroll
+            for (int j=0;j<VDR_Q8_0_Q8_1_MMVQ;++j) c.qs[i][j]=get_int_b2(weights[block].qs,offset+j);
+            c.d[i]=weights[block].d;
+        }
+    }
+}
+
+template<int Waves, int Prefetch>
+static __global__ __launch_bounds__(Waves*32,1) void qwen_q8_matvec(
+        const block_q8_0 * __restrict__ weights, const float * __restrict__ input,
+        float * __restrict__ output, int cols, int rows, size_t row_stride) {
+    const int lane=threadIdx.x, tid=threadIdx.y*32+lane;
+    const int row=blockIdx.x*Waves+threadIdx.y;
+    const int blocks=cols/QK8_0;
+    constexpr int vdr=VDR_Q8_0_Q8_1_MMVQ, step=vdr*32/QI8_0;
+    const int first=lane/(QI8_0/vdr), offset=vdr*(lane%(QI8_0/vdr));
+    // Incomplete final row groups must still reach the shared-memory barrier.
+    const auto * w=weights+size_t(row<rows ? row : rows-1)*row_stride;
+    qwen_q8_chunk<Prefetch> current;
+    qwen_q8_load(current,w,first,offset,blocks);
+    extern __shared__ char storage[];
+    auto * activation=(block_q8_1 *)storage;
+    for (int i=tid;i<4*blocks;i+=Waves*32) {
+        const int block=i/4, part=i%4;
+        const auto * packed_input = (const float4 *)(input + block*32 + part*8);
+        const float4 low = packed_input[0], high = packed_input[1];
+        const float values[8] = { low.x, low.y, low.z, low.w, high.x, high.y, high.z, high.w };
+        float maximum=fabsf(values[0]);
+#pragma unroll
+        for (int j=1;j<8;++j) maximum=fmaxf(maximum,fabsf(values[j]));
+        maximum=fmaxf(maximum,__shfl_xor_sync(0xffffffff,maximum,1,32));
+        maximum=fmaxf(maximum,__shfl_xor_sync(0xffffffff,maximum,2,32));
+        const float d=maximum/127.0f;
+        unsigned q[8];
+#pragma unroll
+        for (int j=0;j<8;++j) q[j]=unsigned(int(maximum==0.0f ? 0 : int8_t(roundf(values[j]/d))))&255;
+        auto * packed=(unsigned *)activation[block].qs;
+        packed[2*part]=q[0]|(q[1]<<8)|(q[2]<<16)|(q[3]<<24);
+        packed[2*part+1]=q[4]|(q[5]<<8)|(q[6]<<16)|(q[7]<<24);
+        if (part==0) activation[block].ds=make_half2(d,0.0f); // Q8_0 dot ignores the sum component.
+    }
+    __syncthreads();
+    if (row>=rows) return;
+    float sum=0;
+    for (int b=first;b<blocks;b+=Prefetch*step) {
+        qwen_q8_chunk<Prefetch> next;
+        if (b+Prefetch*step<blocks) qwen_q8_load(next,w,b+Prefetch*step,offset,blocks);
+#pragma unroll
+        for (int i=0;i<Prefetch;++i) if (b+i*step<blocks) {
+            const auto * a=activation+b+i*step;
+            int packed[vdr];
+#pragma unroll
+            for (int j=0;j<vdr;++j) packed[j]=get_int_b4(a->qs,offset+j);
+            sum+=vec_dot_q8_0_q8_1_impl<float,vdr>(current.qs[i],packed,current.d[i],__low2half(a->ds));
+        }
+        if (b+Prefetch*step<blocks) current=next;
+    }
+    sum=warp_reduce_sum<32>(sum);
+    if (lane==0) output[row]=sum;
+}
+
+bool ggml_cuda_qwen4exp_q8_matvec(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * w, const ggml_tensor * x, ggml_tensor * dst) {
+    const char * enabled=getenv("PARACETAMOL_QWEN4EXP_Q8_MMV");
+    if ((enabled && strcmp(enabled,"0")==0) ||
+            ggml_get_op_params_i32(dst,1)!=GGML_HINT_QWEN4EXP_Q8_DECODE ||
+            ggml_cuda_info().devices[ctx.device].cc!=GGML_CUDA_CC_OFFSET_AMD+0x1151 ||
+            w->type!=GGML_TYPE_Q8_0 || x->type!=GGML_TYPE_F32 || dst->type!=GGML_TYPE_F32 ||
+            !ggml_is_contiguous(w) || !ggml_is_contiguous(x) || !ggml_is_contiguous(dst) ||
+            uintptr_t(x->data) % alignof(float4) != 0 ||
+            w->ne[2]!=1 || w->ne[3]!=1 || x->ne[1]!=1 || x->ne[2]!=1 || x->ne[3]!=1 ||
+            dst->ne[1]!=1 || dst->ne[2]!=1 || dst->ne[3]!=1 ||
+            w->ne[0]!=x->ne[0] || dst->ne[0]!=w->ne[1] ||
+            w->ne[0]%32 || w->ne[0]<32 || w->ne[0]>14336 || w->ne[1]<1 || w->ne[1]>INT_MAX ||
+            ggml_get_op_params_i32(dst,0)!=GGML_PREC_DEFAULT) return false;
+    const int cols=w->ne[0], rows=w->ne[1];
+    const size_t shared=(cols/32)*sizeof(block_q8_1);
+    auto launch=[&](auto kernel,int waves) {
+        kernel<<<dim3((rows+waves-1)/waves),dim3(32,waves),shared,ctx.stream()>>>(
+            (const block_q8_0 *)w->data,(const float *)x->data,(float *)dst->data,cols,rows,w->nb[1]/sizeof(block_q8_0));
+    };
+    int waves = 16;
+    while (waves > 4 && (rows + waves - 1)/waves < 2*ggml_cuda_info().devices[ctx.device].nsm) waves /= 2;
+    constexpr int step = VDR_Q8_0_Q8_1_MMVQ*32/QI8_0;
+    const bool long_rows = cols/32 >= 16*step && rows <= 1024;
+    if (waves == 16) launch(qwen_q8_matvec<16,2>,16);
+    else if (waves == 8) {
+        if (long_rows) launch(qwen_q8_matvec<8,8>,8);
+        else launch(qwen_q8_matvec<8,2>,8);
+    } else {
+        if (long_rows) launch(qwen_q8_matvec<4,8>,4);
+        else launch(qwen_q8_matvec<4,2>,4);
+    }
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
+#endif
