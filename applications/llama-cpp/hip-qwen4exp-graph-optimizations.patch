+    if (!mem_idx || !u.n_tokens || !u.seq_id || !u.seq_id[0] || !u.n_seq_id || u.n_seq_id[0] != 1 ||
+            u.seq_id[0][0] < 0 || u.seq_id[0][0] >= LLAMA_MAX_SEQ) return false;
+    return qwen4exp_qsa_prefix_valid(mem_idx->get_cells(u.seq_id[0][0]), u, n_kv);
+}
+
+void llama_memory_hybrid_idx::set_input_qsa_compact(
+        ggml_tensor * blk_cells, ggml_tensor * blk_pos,
+        ggml_tensor * limits, ggml_tensor * tails,
+        const llama_ubatch & u, uint32_t n_kv, uint32_t ratio) const {
+    GGML_ASSERT(ratio > 1 && qsa_compact_supported(u, n_kv));
+    const auto & cells = mem_idx->get_cells(u.seq_id[0][0]);
+    std::vector<int32_t> by_pos(n_kv, -1);
+    uint32_t count = 0;
+    for (uint32_t j = 0; j < n_kv; ++j) {
+        if (!cells.is_empty(j)) { by_pos[cells.pos_get(j)] = j; ++count; }
+    }
+    const int64_t blocks = blk_pos->ne[0]/4;
+    const int64_t complete = count/ratio;
+    auto * members = (int32_t *) blk_cells->data;
+    auto * positions = (int32_t *) blk_pos->data;
+    auto * bounds = (int32_t *) limits->data;
+    auto * tail = (int32_t *) tails->data;
+    GGML_ASSERT(members && positions && bounds && tail && complete <= blocks);
+    std::fill(members, members + ratio*blocks, 0);
+    std::copy_n(by_pos.data(), ratio*complete, members);
+    for (int axis = 0; axis < 4; ++axis) {
+        for (int64_t b = 0; b < blocks; ++b) { positions[axis*blocks + b] = b < complete ? b*ratio : 0; }
+    }
+    for (int64_t b = 0; b < blocks; ++b) { bounds[b] = b < complete ? b*ratio : INT32_MAX; }
+    std::fill(tail, tail + (ratio - 1)*u.n_tokens, -1);
+    for (uint32_t i = 0; i < u.n_tokens; ++i) {
+        const int32_t end = u.pos[i] + 1;
+        const int32_t start = end/ratio*ratio;
+        bounds[blocks + i] = start;
+        for (int32_t j = start; j < end; ++j) { tail[i*(ratio - 1) + j - start] = by_pos[j]; }
+    }
+}
