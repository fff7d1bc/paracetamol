+static bool qwen4exp_compact_qsa(const llama_memory_hybrid_idx_context * mctx,
+        const llama_ubatch & u, const llama_cparams & cp, const llama_hparams & hp, uint32_t ratio) {
+    const char * graph = getenv("PARACETAMOL_QWEN4EXP_QSA_GRAPH");
+    const char * kernel = getenv("PARACETAMOL_QWEN4EXP_QSA_KERNEL");
+    if (!graph || std::string(graph) != "1" || !kernel || std::string(kernel) != "1" ||
+            !mctx || !mctx->get_idx() || !mctx->get_attn() || ratio != 4 ||
+            hp.indexer_top_k%ratio || hp.indexer_top_k + ratio - 1 > 2560 ||
+            !cp.causal_attn || !cp.flash_attn || !cp.offload_kqv || hp.use_alibi || hp.n_swa ||
+            hp.f_max_alibi_bias != 0 || hp.attn_soft_cap ||
+            hp.n_embd_head_k() != 256 || hp.n_embd_head_v() != 256 ||
+            mctx->get_attn()->type_k() != GGML_TYPE_F16 || mctx->get_attn()->type_v() != GGML_TYPE_F16) {
+        return false;
+    }
+    // Every sparse layer sharing this metadata must fit the selected-key
+    // kernels. A future model with another head ratio keeps the mask path.
+    for (uint32_t il = 0; il < hp.n_layer(); ++il) {
+        if (!hp.is_recr(il) && hp.dsv4_compress_ratios[il] == ratio &&
+                (hp.n_head_kv(il) == 0 || hp.n_head(il) != 12*hp.n_head_kv(il))) {
+            return false;
+        }
+    }
+    const int64_t n_kv = mctx->get_idx()->get_n_kv();
+    return n_kv > hp.indexer_top_k + ratio - 1 && n_kv <= 262140 && mctx->qsa_compact_supported(u);
+}
