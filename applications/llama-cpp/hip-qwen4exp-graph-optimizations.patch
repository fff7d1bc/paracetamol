+#pragma once
+#include "ggml.h"
+
+// Adapted from halo-box/strix-llama.cpp. Preserve the reference's whole-block
+// budget plus partial tail. Invalid selections are -1, never a real cache cell.
+inline ggml_tensor * qwen4exp_select_blocks(ggml_context * ctx, ggml_tensor * score,
+        ggml_tensor * members, ggml_tensor * tail, int64_t budget, int64_t ratio) {
+    const int64_t nb = score->ne[0], nq = score->ne[1];
+    auto * blocks = ggml_cont(ctx, ggml_top_k(ctx, score, budget));
+    auto * order = ggml_argsort(ctx, ggml_cast(ctx, blocks, GGML_TYPE_F32), GGML_SORT_ORDER_ASC);
+    auto * block_view = ggml_view_4d(ctx, blocks, 1, budget, nq, 1,
+            blocks->nb[0], blocks->nb[1], blocks->nb[2], 0);
+    blocks = ggml_reshape_3d(ctx, ggml_get_rows(ctx, block_view, order), budget, nq, 1);
+    auto * score_view = ggml_view_4d(ctx, score, 1, nb, nq, 1,
+            score->nb[0], score->nb[1], score->nb[2], 0);
+    auto * chosen = ggml_get_rows(ctx, score_view, blocks);
+    auto * valid = ggml_step(ctx, ggml_scale_bias(ctx, chosen, 1.0f, 1.0f));
+    auto * cells = ggml_get_rows(ctx, ggml_reshape_3d(ctx, members, ratio, nb, 1),
+            ggml_reshape_2d(ctx, blocks, budget*nq, 1));
+    cells = ggml_reshape_4d(ctx, cells, ratio, budget, nq, 1);
+    cells = ggml_scale_bias(ctx, ggml_cast(ctx, cells, GGML_TYPE_F32), 1.0f, 1.0f);
+    cells = ggml_mul(ctx, cells, valid);
+    cells = ggml_cast(ctx, ggml_scale_bias(ctx, cells, 1.0f, -1.0f), GGML_TYPE_I32);
+    cells = ggml_reshape_4d(ctx, cells, budget*ratio, nq, 1, 1);
+    return ggml_concat(ctx, cells, ggml_reshape_4d(ctx, tail, ratio - 1, nq, 1, 1), 0);
+}
