+// Exact graph/closure match from the Strix fork. Retain upstream allocation
+// dependencies and alias checks so a fused read cannot outlive its input.
+static int qsa_match_score(const ggml_cgraph * g, int i, ggml_cuda_idx_relu_sum_args & a) {
+    if (i + 4 >= g->n_nodes) return 0;
+    const auto * relu = g->nodes[i];
+    if (strcmp(relu->name, "qwen4exp_qsa_scores") != 0 ||
+            relu->op != GGML_OP_UNARY || ggml_get_unary_op(relu) != GGML_UNARY_OP_RELU ||
+            relu->type != GGML_TYPE_F32 || !ggml_is_contiguous(relu)) return 0;
+    const auto * src = relu->src[0];
+    if (!src || src->type != GGML_TYPE_F32 || !ggml_is_contiguous(src) || !ggml_are_same_shape(src, relu)) return 0;
+    const int64_t nb = relu->ne[0], heads = relu->ne[1], nt = relu->ne[2], ns = relu->ne[3];
+    if (heads < 2 || heads > 14 || nb < 64 || nb > INT_MAX || nt*ns < 64 || nt*ns > UINT16_MAX) return 0;
+    auto slice = [&](const ggml_tensor * v, int h) {
+        return v->op == GGML_OP_VIEW && v->view_src == relu && v->type == GGML_TYPE_F32 &&
+            v->ne[0] == nb && v->ne[1] == nt && v->ne[2] == ns && v->ne[3] == 1 &&
+            v->nb[0] == sizeof(float) && v->nb[1] == relu->nb[2] && v->nb[2] == relu->nb[3] &&
+            v->view_offs == size_t(h)*relu->nb[1];
+    };
+    const auto * cont = g->nodes[i+2];
+    if (!slice(g->nodes[i+1], 0) || cont->op != GGML_OP_CONT || cont->src[0] != g->nodes[i+1] ||
+            cont->type != GGML_TYPE_F32 || !ggml_is_contiguous(cont) ||
+            !ggml_are_same_shape(cont, g->nodes[i+1])) return 0;
+    const ggml_tensor * prev = cont;
+    int end = i+3;
+    for (int h=1; h<heads; ++h) {
+        if (end+1 >= g->n_nodes) return 0;
+        const auto * view=g->nodes[end], * add=g->nodes[end+1];
+        if (!slice(view,h) || add->op != GGML_OP_ADD || add->type != GGML_TYPE_F32 ||
+                add->src[0] != prev || add->src[1] != view || !ggml_are_same_shape(add,cont) || !ggml_is_contiguous(add)) return 0;
+        prev=add; end+=2;
+    }
+    const int count=end-i, output=end-1;
+    int indices[32]; ggml_op ops[32];
+    GGML_ASSERT(count<=32);
+    for (int j=0;j<count;++j) { indices[j]=i+j; ops[j]=g->nodes[i+j]->op; }
+    if (!ggml_can_fuse_subgraph_ext(g,indices,count,ops,&output,1)) return 0;
+    a.score=src; a.dst=const_cast<ggml_tensor *>(prev); a.heads=heads;
+    return count;
+}
