+    if (seq < 0 || seq >= LLAMA_MAX_SEQ) { return false; }
+    if (n_kv == 0 || n_kv > cells.size()) { return false; }
+    std::vector<bool> seen(n_kv, false);
+    uint32_t count = 0;
+    llama_pos maximum = -1;
+    for (uint32_t j = 0; j < n_kv; ++j) {
+        if (cells.is_empty(j)) { continue; }
+        const llama_pos pos = cells.pos_get(j);
+        if (cells.seq_get_all(j).count() != 1 || !cells.seq_has(j, seq) || pos < 0 ||
+                uint32_t(pos) >= n_kv || seen[pos] ||
+                (u.is_pos_2d() && (cells.ext_get(j).x != pos || cells.ext_get(j).y != pos))) { return false; }
+        seen[pos] = true;
+        maximum = std::max(maximum, pos);
+        ++count;
+    }
+    if (count == 0 || uint32_t(maximum + 1) != count) { return false; }
+    for (uint32_t i = 0; i < u.n_tokens; ++i) {
+        if (u.n_seq_id[i] != 1 || !u.seq_id[i] || u.seq_id[i][0] != seq ||
+                u.pos[i] < 0 || u.pos[i] > maximum) { return false; }
+        for (uint32_t axis = 1; axis < u.n_pos; ++axis) {
+            if (u.pos[i + axis*u.n_tokens] != u.pos[i]) { return false; }
+        }
+    }
+    return true;
+}
