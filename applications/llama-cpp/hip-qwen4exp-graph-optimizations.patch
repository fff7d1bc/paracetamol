index 000000000..41f5df36e
--- /dev/null
+++ b/tests/test-qwen4exp-qsa-prefix.cpp
@@ -0,0 +1,53 @@
+#include "../src/qwen4exp-qsa-prefix.h"
+#include <cstdio>
+#include <cstdlib>
+
+static void check(bool value, const char * name) {
+    if (!value) { fprintf(stderr,"FAIL: %s\n",name); std::exit(1); }
+}
+
+int main() {
+    llama_kv_cells cells;
+    cells.resize(32);
+    // Prefix positions are deliberately stored in non-sequential physical cells.
+    for (int p=0;p<12;++p) { int c=(p*7)%32; cells.pos_set(c,p); cells.seq_add(c,3); }
+    llama_token tokens[4]={1,2,3,4};
+    llama_pos positions[16]={8,9,10,11};
+    int32_t counts[4]={1,1,1,1};
+    llama_seq_id seq=3;
+    llama_seq_id * seqs[4]={&seq,&seq,&seq,&seq};
+    llama_ubatch u{};
+    u.n_tokens=4; u.n_pos=1; u.token=tokens; u.pos=positions; u.n_seq_id=counts; u.seq_id=seqs;
+    auto valid=[&](){return qwen4exp_qsa_prefix_valid(cells,u,32);};
+    check(valid(),"permuted scalar prefix");
+    cells.seq_add(0,4);
+    check(!valid(),"shared cache cell");
+    cells.seq_rm(0,4);
+    check(valid(),"removed sharing");
+    cells.rm(7);
+    check(!valid(),"hole in logical prefix");
+    cells.pos_set(7,1); cells.seq_add(7,3);
+    cells.pos_set(30,4); cells.seq_add(30,3);
+    check(!valid(),"duplicate position");
+    cells.rm(30);
+    seq=4;
+    check(!valid(),"foreign query sequence");
+    seq=3; counts[2]=0;
+    check(!valid(),"missing query sequence");
+    counts[2]=1; positions[3]=12;
+    check(!valid(),"query outside prefix");
+    positions[3]=11; u.token=nullptr;
+    check(!valid(),"embedding input");
+    u.token=tokens; u.n_pos=4;
+    for (int a=1;a<4;++a) for (int i=0;i<4;++i) positions[a*4+i]=positions[i];
+    for (int p=0;p<12;++p) { llama_kv_cell_ext ext; ext.x=ext.y=p; cells.ext_set((p*7)%32,ext); }
+    check(valid(),"scalar multi-axis positions");
+    positions[7]--;
+    check(!valid(),"non-scalar query");
+    positions[7]++;
+    llama_kv_cell_ext ext; ext.x=0; ext.y=1; cells.ext_set(0,ext);
+    check(!valid(),"non-scalar cached position");
+    cells.reset();
+    check(!valid(),"empty cache");
+    puts("Qwen4exp QSA prefix eligibility passed");
+}
