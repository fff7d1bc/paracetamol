diff --git a/ggml/src/ggml-cuda/qsa-score.cu b/ggml/src/ggml-cuda/qsa-score.cu
new file mode 100644
index 000000000..b74ad26e8
--- /dev/null
+++ b/ggml/src/ggml-cuda/qsa-score.cu
@@ -0,0 +1,56 @@
+// Adapted from halo-box/strix-llama.cpp, MIT, commit 7a9196dad8b13b70fb3420886aadaf98fc09b849.
+#include "qsa-score.cuh"
+#if defined(GGML_USE_HIP)
+
+// Same ordered F32 additions as GET_ROWS -> CONT/ADD -> SCALE, without
+// materializing four copies of every pooled key.
+template<typename T>
+static __global__ void qsa_pool4(const char * src, const char * ids, float * dst,
+        size_t row_stride, size_t stream_stride, size_t ids_stride) {
+    const int64_t group = blockIdx.x, stream = blockIdx.y;
+    const int col = threadIdx.x;
+    const int32_t * selected = (const int32_t *)(ids + stream*ids_stride) + 4*group;
+    const char * input = src + stream*stream_stride;
+    float sum = float(((const T *)(input + selected[0]*row_stride))[col]);
+    for (int i=1;i<4;++i) sum += float(((const T *)(input + selected[i]*row_stride))[col]);
+    dst[(stream*gridDim.x + group)*128 + col] = sum*0.25f;
+}
+
+void ggml_cuda_op_get_rows_mean4(ggml_backend_cuda_context & ctx, const ggml_tensor * src,
+        const ggml_tensor * ids, ggml_tensor * dst) {
+    const dim3 grid(dst->ne[1],dst->ne[2],1);
+    if (src->type == GGML_TYPE_F16) {
+        qsa_pool4<half><<<grid,128,0,ctx.stream()>>>((const char *)src->data,(const char *)ids->data,
+            (float *)dst->data,src->nb[1],src->nb[2],ids->nb[1]);
+    } else {
+        qsa_pool4<float><<<grid,128,0,ctx.stream()>>>((const char *)src->data,(const char *)ids->data,
+            (float *)dst->data,src->nb[1],src->nb[2],ids->nb[1]);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+// Preserve the head addition order of the RELU/CONT/ADD graph.
+static __global__ void idx_relu_sum_f32(const float * __restrict__ src, float * __restrict__ dst,
+                                        const int n_blocks, const int heads) {
+    const int b = blockIdx.x * blockDim.x + threadIdx.x;
+    if (b >= n_blocks) return;
+    const int64_t tt = blockIdx.y;                         // token within stream, streams stacked
+    const float * p  = src + tt * (int64_t) heads * n_blocks + b;
+    float acc = fmaxf(p[0], 0.0f);
+    for (int h = 1; h < heads; ++h) {
+        acc = acc + fmaxf(p[(int64_t) h * n_blocks], 0.0f);
+    }
+    dst[tt * (int64_t) n_blocks + b] = acc;
+}
+
+void ggml_cuda_op_idx_relu_sum(ggml_backend_cuda_context & ctx, const ggml_cuda_idx_relu_sum_args & args) {
+    const ggml_tensor * s = args.score;
+    const int n_blocks = (int) s->ne[0];
+    const int64_t rows = s->ne[2] * s->ne[3];
+    constexpr int threads = 256;
+    const dim3 grid((n_blocks + threads - 1) / threads, (unsigned) rows, 1);
+    idx_relu_sum_f32<<<grid, threads, 0, ctx.stream()>>>((const float *) s->data, (float *) args.dst->data, n_blocks, args.heads);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+#endif
