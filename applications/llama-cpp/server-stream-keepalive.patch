From 221c0b2e6c815b32b2d629a1830ad04502807ecb Mon Sep 17 00:00:00 2001
From: Srijan Keshri <212402043+arcusbuilds@users.noreply.github.com>
Date: Wed, 14 Oct 2026 09:02:21 +0530
Subject: [PATCH] fixed the server **closing a connection after a successful
 streamed answer even when connection coud be reused

Assisted-by: Codex
---
 tools/server/server-http.cpp               |  2 +-
 tools/server/tests/unit/test_completion.py | 25 ++++++++++++++++++++++
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/tools/server/server-http.cpp b/tools/server/server-http.cpp
index 33cbb156c..71e7fd751 100644
--- a/tools/server/server-http.cpp
+++ b/tools/server/server-http.cpp
@@ -656,7 +656,7 @@ static void process_handler_response(server_http_req_ptr && request, server_http
                 sink.done();
                 SRV_DBG("%s", "http: stream ended\n");
             }
-            return has_next;
+            return true;
         };
         const auto on_complete = [request = q_ptr, response = r_ptr](bool) mutable {
             response->on_complete();
diff --git a/tools/server/tests/unit/test_completion.py b/tools/server/tests/unit/test_completion.py
index b62abc661..11455870e 100644
--- a/tools/server/tests/unit/test_completion.py
+++ b/tools/server/tests/unit/test_completion.py
@@ -1,3 +1,4 @@
+import http.client
 import pytest
 import requests
 import time
@@ -93,6 +94,30 @@ def test_completion_stream_vs_non_stream():
     assert content_stream == res_non_stream.body["content"]
 
 
+def test_completion_connection_reuse():
+    server.start()
+    conn = http.client.HTTPConnection(server.server_host, server.server_port, timeout=30)
+    try:
+        conn.connect()
+        conn.auto_open = 0
+        original_socket = conn.sock
+        conn.request("POST", "/completion", json.dumps({
+            "prompt": "Hello", "n_predict": 4, "stream": True,
+        }), {"Content-Type": "application/json"})
+        with conn.getresponse() as response:
+            assert response.status == 200
+            assert response.chunked
+            assert not response.will_close
+            assert response.read()
+        conn.request("GET", "/health")
+        with conn.getresponse() as response:
+            assert response.status == 200
+            assert json.loads(response.read())["status"] == "ok"
+        assert conn.sock is original_socket
+    finally:
+        conn.close()
+
+
 def test_completion_with_openai_library():
     global server
     server.start()
