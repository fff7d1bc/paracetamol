+            auto * gdn         = ggml_gated_delta_net(ctx, q, k, v, g, b, state, 1);
+            auto * state_cache = inplace ? input_cache : ggml_new_tensor_3d(ctx, GGML_TYPE_F32, D, 1, 1);
+            auto * state_dst   = ggml_view_3d(ctx, state_cache, D, 1, 1, D * sizeof(float), D * sizeof(float),
+                                              guard == 4 ? sizeof(float) : 0);
+            auto * state_src =
+                ggml_view_3d(ctx, gdn, D, 1, 1, D * sizeof(float), D * sizeof(float), S * H * sizeof(float));
+            auto * state_copy = ggml_cpy(ctx, state_src, state_dst);
+            ggml_build_forward_expand(gf, state_copy);
+            auto * attn =
+                ggml_view_4d(ctx, gdn, S, H, 1, 1, S * sizeof(float), S * H * sizeof(float), S * H * sizeof(float), 0);
+            auto *        out   = ggml_mul(ctx, ggml_rms_norm(ctx, attn, 1e-6f), normw);
+            ggml_tensor * extra = nullptr;
+            if (guard == 3) {
+                ggml_build_forward_expand(gf, out);
+                extra = ggml_scale(ctx, cc, 0.5f);
+                ggml_build_forward_expand(gf, extra);
+            }
+            out = ggml_concat(ctx, ggml_reshape_1d(ctx, out, S * H), ggml_reshape_1d(ctx, state_copy, D), 0);
+            if (extra) {
+                out = ggml_concat(ctx, out, ggml_reshape_1d(ctx, extra, 4 * C), 0);
+            }
+            if (guard == 1) {
+                out = ggml_concat(ctx, out, ggml_reshape_1d(ctx, cc, 4 * C), 0);
+            }
+            return ggml_concat(ctx, out, ggml_reshape_1d(ctx, conv_copy, 3 * C), 0);
+        };
+        return ggml_sub(ctx, branch(false), branch(true));
+    }
+};
