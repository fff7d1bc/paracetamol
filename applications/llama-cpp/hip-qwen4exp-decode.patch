+struct test_qwen_gdn_decode : public test_case {
+    int  key_heads, guard;
+    bool materialized, inplace, reshaped;
+
+    // Guards cover exposed intermediates, a non-Qwen graph, an external
+    // reader, a shifted state output, overwritten convolution history and
+    // a misaligned norm weight that requires upstream's scalar RMS path.
+    // Each must fall back while still producing the same result. Reshaped
+    // cache roots reproduce the model's metadata views without adding reads.
+    test_qwen_gdn_decode(int key_heads, int guard, bool materialized, bool inplace, bool reshaped) :
+        key_heads(key_heads),
+        guard(guard),
+        materialized(materialized),
+        inplace(inplace),
+        reshaped(reshaped) {}
+
+    std::string op_desc(ggml_tensor *) override { return "QWEN_GDN_DECODE"; }
+
+    std::string vars() override { return VARS_TO_STR5(key_heads, guard, materialized, inplace, reshaped); }
+
+    bool run_whole_graph() override { return true; }
+
+    double max_nmse_err() override { return 0; }
+
+    double err(const float * actual, const float *, size_t n) override {
+        for (size_t i = 0; i < n; ++i) {
+            if (actual[i] != 0.0f) {
+                return INFINITY;
+            }
+        }
+        return 0;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (auto * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+            if (ggml_is_view_op(t->op)) {
+                continue;
