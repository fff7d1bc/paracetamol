+            auto * q           = norm(view(key_heads, 0));
+            auto * k           = norm(view(key_heads, S * key_heads));
+            auto * v           = view(H, 2 * S * key_heads);
+            auto * g           = ggml_mul(ctx, ggml_softplus(ctx, ggml_add(ctx, alpha, dt)), a);
