+            }
+            auto * conv_cache = guard == 5 ? input_history : ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 3, C);
+            auto * conv_dst   = ggml_view_2d(ctx, conv_cache, 3, C, 3 * sizeof(float), 0);
+            auto * tail       = ggml_view_2d(ctx, cc, 3, C, cc->nb[1], sizeof(float));
+            if (materialized) {
+                tail = ggml_cont(ctx, tail);
+            }
+            auto * conv_copy = ggml_cpy(ctx, tail, conv_dst);
+            ggml_build_forward_expand(gf, conv_copy);
+            auto * state = ggml_get_rows(ctx, reshaped ? ggml_reshape_2d(ctx, input_cache, D, 2) : input_cache, ids);
+            ggml_build_forward_expand(gf, state);
+            state       = ggml_reshape_4d(ctx, state, S, S, H, 1);
+            auto * silu = ggml_silu(ctx, ggml_ssm_conv(ctx, cc, taps));
+            auto   view = [&](int heads, int start) {
+                return ggml_view_4d(ctx, silu, S, heads, 1, 1, S * sizeof(float), C * sizeof(float), C * sizeof(float),
+                                    start * sizeof(float));
+            };
+            auto norm = [&](ggml_tensor * t) {
