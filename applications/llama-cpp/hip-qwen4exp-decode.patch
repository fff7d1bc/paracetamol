+
+// Qwen4exp single-token decode on gfx1151. Adapt the Strix fork's fusion,
+// but retain this upstream pin's F32 reduction and FMA ordering. Four blocks
+// per value head own disjoint recurrent-state columns. Convolution inputs
+// are read by several blocks, so their output cache may not alias inputs.
+// Normalization is a second kernel because its output can reuse graph inputs.
+
+static __device__ __forceinline__ float gdn_decode_sigmoid(float x) {
+    return 1.0f / (1.0f + expf(-x));
+}
+
+static __device__ __forceinline__ float gdn_decode_softplus(float x) {
+    return (x > 20.0f) ? x : log1pf(expf(x));
+}
+
+template <int S, int D_CONV>
+__global__ void __launch_bounds__(32 * 8, 1) gdn_decode_fused_cuda(const ggml_cuda_gdn_decode_args args) {
+    constexpr int warp_size = 32;
+    constexpr int nwarps    = 8;
+    static_assert(S == 128);
+
+    __shared__ float q_c[S];
+    __shared__ float k_c[S];
+    __shared__ float v_c[S];
+    __shared__ float q_n[S];
+    __shared__ float k_n[S];
+    __shared__ float attn[S];
+
+    const int h      = blockIdx.x;  // value head
+    const int lane   = threadIdx.x;
+    const int warp   = threadIdx.y;
+    const int thread = warp * warp_size + lane;
+    const int hk     = h % args.H_k;  // key/query head (fastmodulo(h_idx, neqk1) in gated_delta_net_cuda)
+
+    // 1. causal conv + SiLU for this head's q, k and v channels; shift the conv state (CPY conv_state_last)
+    for (int element = thread; element < 3 * S; element += warp_size * nwarps) {
+        const int part = element / S;  // 0: q, 1: k, 2: v
+        const int i    = element % S;
+        const int c    = part == 0 ? hk * S : part == 1 ? args.H_k * S + hk * S : 2 * args.H_k * S + h * S;
+        const int ch   = c + i;
+
+        float x[D_CONV];
+        float w[D_CONV];
+#pragma unroll
+        for (int j = 0; j < D_CONV - 1; j++) {
+            x[j] = args.conv_state_in[ch * (D_CONV - 1) + j];
+        }
+        x[D_CONV - 1] = args.qkv[ch * args.qkv_stride];
+#pragma unroll
+        for (int j = 0; j < D_CONV; j++) {
+            w[j] = args.conv_w[ch * D_CONV + j];
+        }
+
+        // ssm_conv_f32: fma chain from 0, then the (zero) bias add, then SiLU
+        float sumf = fmaf(x[0], w[0], 0.0f);
+#pragma unroll
+        for (int j = 1; j < D_CONV; j++) {
+            sumf = fmaf(x[j], w[j], sumf);
+        }
+        sumf += args.conv_bias;
+        const float y = ggml_cuda_op_silu_single(sumf);
+
+        if (part == 0) {
+            q_c[i] = y;
+        } else if (part == 1) {
+            k_c[i] = y;
+        } else {
+            v_c[i] = y;
+        }
+
+        // q/k channels are shared by H_v/H_k value heads: the first one writes the conv state
+        if (blockIdx.z == 0 && (part == 2 || h == hk)) {
+#pragma unroll
+            for (int j = 0; j < D_CONV - 1; j++) {
+                args.conv_state_out[ch * (D_CONV - 1) + j] = x[j + 1];
+            }
+        }
+    }
+    __syncthreads();
+
+    {
+        // Match upstream's aligned float4 RMS path: four consecutive squares
+        // per lane, then one wave reduction. Dispatch rejects scalar layouts.
+        if (warp < 2) {
+            const int iqk = warp;
+            const float * x = iqk == 0 ? q_c : k_c;
+            float * y = iqk == 0 ? q_n : k_n;
+            const int i = 4 * lane;
+            const float total = warp_reduce_sum<warp_size>(
+                x[i]*x[i] + x[i+1]*x[i+1] + x[i+2]*x[i+2] + x[i+3]*x[i+3]);
+            const float scale = rsqrtf(total / (float) args.S + args.qk_rms_eps[iqk]);
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {
+                y[i+j] = fmaf(args.qk_scale_mul[iqk], scale * x[i+j], args.qk_scale_add[iqk]);
+            }
+        }
+    }
+
+    // gate = softplus(alpha + dt_bias) * A, beta = sigmoid(beta): scalar per head, computed by every thread
+    const float alpha_biased = args.alpha[h] + args.dt_bias[h];
+    const float gate         = gdn_decode_softplus(alpha_biased) * args.ssm_a[h];
+    const float beta_val     = gdn_decode_sigmoid(args.beta[h]);
+    const float g_val        = expf(gate);
+    __syncthreads();
+
+    // Match current upstream's four independent 8-lane columns per wave.
+    // The fork's older 32-lane reduction has a different rounding sequence.
+    constexpr int lanes_per_col = 8;
+    constexpr int rows          = S / lanes_per_col;
+    const int     col_base      = blockIdx.z * (nwarps * 4);
+    {
+        const int     local = lane % lanes_per_col;
+        const int     col   = col_base + warp * 4 + lane / lanes_per_col;
+        const float * state_in =
+            args.state_cache + int64_t(args.state_ids[0]) * args.state_row_stride + int64_t(h) * S * S + col * S;
+        float shard[rows], kr[rows], qr[rows];
+#pragma unroll
+        for (int r = 0; r < rows; ++r) {
+            const int j = r * lanes_per_col + local;
+            shard[r]    = state_in[j];
+            kr[r]       = k_n[j];
+            qr[r]       = q_n[j];
+        }
+        float kv = 0.0f;
+#pragma unroll
+        for (int r = 0; r < rows; ++r) {
+            kv += shard[r] * kr[r];
+        }
+        const float sum     = warp_reduce_sum<lanes_per_col>(kv);
+        const float delta   = (v_c[col] - g_val * sum) * beta_val;
+        float       partial = 0.0f;
+#pragma unroll
+        for (int r = 0; r < rows; ++r) {
+            shard[r] = g_val * shard[r] + kr[r] * delta;
+            partial += shard[r] * qr[r];
+        }
+        const float value = warp_reduce_sum<lanes_per_col>(partial);
+        if (local == 0) {
+            attn[col] = value * args.scale;
+        }
+#pragma unroll
+        for (int r = 0; r < rows; ++r) {
+            args.state_out[int64_t(h) * S * S + col * S + r * lanes_per_col + local] = shard[r];
+        }
+    }
+    __syncthreads();
+
+    // 4. pre-norm attention output to the scratch buffer (the weighted rms norm runs as a second kernel: its
+    //    destination may alias inputs of this kernel that other blocks are still reading)
+    if (thread < nwarps * 4) {
+        args.attn_out[(int64_t) h * S + col_base + thread] = attn[col_base + thread];
+    }
+}
+
+// Same float4 F32 reduction as upstream's aligned weighted RMS operation.
+template <int S>
+__global__ void __launch_bounds__(32, 1) gdn_decode_norm_cuda(const float * attn,
+                                                             const float * norm_w,
+                                                             float *       out,
+                                                             const float   eps) {
+    constexpr int warp_size = 32;
+    static_assert(S == 4 * warp_size);
+    const int h    = blockIdx.x;
+    const int tid  = threadIdx.x;
+    const float4 xi = ((const float4 *) (attn + (int64_t) h * S))[tid];
+    const float tmp = warp_reduce_sum<warp_size>(xi.x*xi.x + xi.y*xi.y + xi.z*xi.z + xi.w*xi.w);
+    const float mean           = tmp / (float) S;
+    const float scale          = rsqrtf(mean + eps);
+    const float4 w = ((const float4 *) norm_w)[tid];
+    ((float4 *) (out + (int64_t) h * S))[tid] = make_float4(
+        scale*xi.x*w.x, scale*xi.y*w.y, scale*xi.z*w.z, scale*xi.w*w.w);
+}
+
+void ggml_cuda_op_gdn_decode_fused(ggml_backend_cuda_context & ctx, const ggml_cuda_gdn_decode_args & args_in) {
+    GGML_ASSERT(args_in.S == 128 && args_in.d_conv == 4);
+    ggml_cuda_pool_alloc<float> attn(ctx.pool(), args_in.S * args_in.H_v);
+    ggml_cuda_gdn_decode_args   args = args_in;
+    args.attn_out                    = attn.get();
+
+    const dim3                           grid(args.H_v, 1, 4);
+    const dim3                           block(32, 8, 1);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(grid, block, 0, ctx.stream());
+    ggml_cuda_kernel_launch(gdn_decode_fused_cuda<128, 4>, launch_params, args);
+
+    const dim3                           norm_grid(args.H_v, 1, 1);
+    const dim3                           norm_block(32, 1, 1);
+    const ggml_cuda_kernel_launch_params norm_params =
+        ggml_cuda_kernel_launch_params(norm_grid, norm_block, 0, ctx.stream());
+    ggml_cuda_kernel_launch(gdn_decode_norm_cuda<128>, norm_params, attn.get(), args.norm_w, args.out, args.eps_rms);
+}
