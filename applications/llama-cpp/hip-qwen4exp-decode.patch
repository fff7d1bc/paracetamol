+static int ggml_cuda_try_gdn_decode_fusion(const ggml_cgraph *         cgraph,
+                                           int                         node_idx,
+                                           ggml_cuda_gdn_decode_args & args,
+                                           bool                        aliases) {
+    const ggml_tensor * concat = cgraph->nodes[node_idx];
+    if (concat->op != GGML_OP_CONCAT || strcmp(concat->name, "qwen4exp_gdn_history") != 0 ||
+        concat->type != GGML_TYPE_F32 || ggml_get_op_params_i32(concat, 0) != 0) {
+        return 0;
+    }
+    const int64_t d_conv = concat->ne[0];
+    const int64_t C      = concat->ne[1];
+    if (d_conv != 4 || concat->ne[2] != 1 || concat->ne[3] != 1 || !ggml_is_contiguous(concat)) {
+        return 0;
+    }
+    const ggml_tensor * conv_state = concat->src[0];  // [d_conv-1, C, 1]
+    const ggml_tensor * qkv_t      = concat->src[1];  // [1, C, 1]
+    if (conv_state->type != GGML_TYPE_F32 || qkv_t->type != GGML_TYPE_F32 || conv_state->ne[0] != d_conv - 1 ||
+        conv_state->ne[1] != C || conv_state->ne[2] != 1 || !ggml_is_contiguous(conv_state) || qkv_t->ne[0] != 1 ||
+        qkv_t->ne[1] != C || qkv_t->ne[2] != 1 || qkv_t->nb[1] % sizeof(float) != 0) {
+        return 0;
+    }
+
+    // collect the following compute nodes
+    constexpr int n_ops           = 14;
+    const ggml_op expected[n_ops] = {
+        GGML_OP_CPY,      GGML_OP_GET_ROWS, GGML_OP_SSM_CONV, GGML_OP_UNARY, GGML_OP_RMS_NORM,        GGML_OP_RMS_NORM,
+        GGML_OP_ADD,      GGML_OP_UNARY,    GGML_OP_MUL,      GGML_OP_UNARY, GGML_OP_GATED_DELTA_NET, GGML_OP_CPY,
+        GGML_OP_RMS_NORM, GGML_OP_MUL,
+    };
+    const ggml_tensor * n[n_ops];
+    int                 idx[n_ops];
+    int                 found       = 0;
+    int                 last        = node_idx;
+    // Keep each Qwen4exp RMS_NORM + SCALE pair at one logical index. Views
+    // and an optional materialized convolution-state copy widen the range.
+    const ggml_tensor * qk_scale[2] = { nullptr, nullptr };
+    const ggml_tensor * conv_cont   = nullptr;
+    for (int j = node_idx + 1; j < cgraph->n_nodes && found < n_ops;) {
+        const ggml_tensor * t = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(t)) {
+            ++j;
+            continue;
+        }
+        if (t->type != GGML_TYPE_F32) {
+            return 0;
+        }
+        if (found == 0 && t->op == GGML_OP_CONT && !conv_cont) {
+            conv_cont = t;
+            ++j;
+            continue;
+        }
+        if (found == 4 || found == 5) {
+            const int iqk = found - 4;
+            if (t->op == GGML_OP_RMS_NORM && t->src[1] == nullptr) {
