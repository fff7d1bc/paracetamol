+        if (guard == 6) {
+            normw = ggml_view_1d(ctx, ggml_new_tensor_1d(ctx, GGML_TYPE_F32, S + 4), S, sizeof(float));
+            // Both branches must expose the same upstream RMS/MUL fusion.
+            ggml_build_forward_expand(gf, normw);
+        }
+        auto   branch = [&](bool reference) {
+            auto * input_cache = inplace ? ggml_dup(ctx, cache) : cache;
+            if (inplace) {
+                ggml_build_forward_expand(gf, input_cache);
+            }
+            auto * input_history = guard == 5 ? ggml_dup(ctx, history) : history;
+            if (guard == 5) {
