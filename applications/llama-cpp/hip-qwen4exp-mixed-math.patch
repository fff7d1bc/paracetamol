diff --git a/ggml/src/ggml-cuda/qwen4exp-mmb.cu b/ggml/src/ggml-cuda/qwen4exp-mmb.cu
new file mode 100644
index 0000000..321968f
--- /dev/null
+++ b/ggml/src/ggml-cuda/qwen4exp-mmb.cu
@@ -0,0 +1,286 @@
+// Opt-in matrix extraction from halo-box/strix-llama.cpp, MIT,
+// 7a9196dad8b13b70fb3420886aadaf98fc09b849. Explicit opt-in only.
+// No shadow-weight cache, BF16-only tensor marks or reduced-precision residuals.
+#include "qwen4exp-mmb.cuh"
+
+#if defined(GGML_USE_HIP)
+namespace {
+typedef short v16s __attribute__((ext_vector_type(16)));
+typedef float v8f __attribute__((ext_vector_type(8)));
+
+__device__ __forceinline__ uint16_t qwen_bf16(float f) {
+    uint32_t u = __float_as_uint(f);
+    if ((u & 0x7fffffffU) > 0x7f800000U) return uint16_t((u >> 16) | 0x0040U);
+    u += 0x7fffu + ((u >> 16) & 1u);
+    return uint16_t(u >> 16);
+}
+__device__ __forceinline__ uint4 qwen_load4(const uint8_t * p) {
+    // A pair of Q8 blocks occupies 68 bytes. Only four-byte alignment is
+    // guaranteed here, unlike the BF16 input and shared-memory tiles.
+    const uint32_t * u = reinterpret_cast<const uint32_t *>(p);
+    return make_uint4(u[0], u[1], u[2], u[3]);
+}
+__device__ __forceinline__ uint32_t qwen_bf16_pair(float a, float b) {
+    return uint32_t(qwen_bf16(a)) | (uint32_t(qwen_bf16(b)) << 16);
+}
+__device__ __forceinline__ uint32_t qwen_weight_pair(float a, float b) {
+    uint32_t x=__float_as_uint(a),y=__float_as_uint(b);
+    x+=0x7fffu+((x>>16)&1u); y+=0x7fffu+((y>>16)&1u);
+    return (x>>16)|(y&0xffff0000u);
+}
+static __global__ void qwen_bf16_input(const float * x, uint16_t * y, size_t n) {
+    const size_t i = ((size_t) blockIdx.x * blockDim.x + threadIdx.x) * 8;
+    if (i + 8 <= n) {
+        const float4 a = *(const float4 *)(x+i), b = *(const float4 *)(x+i+4);
+        *(uint4 *)(y+i) = make_uint4(qwen_bf16_pair(a.x,a.y),qwen_bf16_pair(a.z,a.w),
+            qwen_bf16_pair(b.x,b.y),qwen_bf16_pair(b.z,b.w));
+    }
+}
+
+// The fork's Q8_0 -> BF16 shared-memory tile decoder. Stored weights stay Q8.
+__device__ __forceinline__ void qwen_bf16_q8_row(const uint4 a, const uint4 b,
+        const uint4 c, const uint4 d, uint32_t tail, uint32_t * out) {
+    const uint32_t w[17] = {a.x,a.y,a.z,a.w,b.x,b.y,b.z,b.w,c.x,c.y,c.z,c.w,d.x,d.y,d.z,d.w,tail};
+    const float d0 = float(__builtin_bit_cast(_Float16,uint16_t(w[0])));
+    const float d1 = float(__builtin_bit_cast(_Float16,uint16_t(w[8]>>16)));
+#pragma unroll
+    for (int blk=0; blk<2; ++blk) {
+        const float scale = blk ? d1 : d0;
+#pragma unroll
+        for (int k=0; k<8; ++k) {
+            const uint32_t v = blk ? w[9+k] : (w[k]>>16) | (w[k+1]<<16);
+            out[16*blk+2*k] = qwen_weight_pair(scale*int8_t(v),scale*int8_t(v>>8));
+            out[16*blk+2*k+1] = qwen_weight_pair(scale*int8_t(v>>16),scale*int8_t(v>>24));
+        }
+    }
+}
+
+template <int BN, int WTM>
+static __global__ __launch_bounds__(256,2) void qwen_q8_bf16_wmma(
+        const uint8_t * W, const uint16_t * X, float * D, int M, int K, int T) {
+#if defined(__HIP_DEVICE_COMPILE__) && !defined(RDNA3)
+    NO_DEVICE_CODE;
+#else
+    constexpr int BM=128, BK=64, LS=72, WTN=64, WM=BM/WTM, TM=WTM/16, TN=WTN/16;
+    static_assert(WM*(BN/WTN)*32 == 256, "whole waves");
+    __shared__ __align__(16) uint16_t As[BM*LS], Bs[BN*LS];
+    const int tid=threadIdx.x, lane=tid&31, wave=tid>>5, wm=wave%WM, wn=wave/WM;
+    const int m0=blockIdx.x*BM, t0=blockIdx.y*BN;
+    const size_t row_bytes=size_t(K/32)*34;
+    uint4 wa{},wb{},wc{},wd{};
+    uint32_t wt=0;
+    constexpr int B_ITEMS=BN*8/256;
+    uint4 bx[B_ITEMS];
+    auto load = [&](int ks) {
+        if (tid < BM && m0+tid < M) {
+            const uint8_t * p=W+size_t(m0+tid)*row_bytes+size_t(ks)*68;
+            wa=qwen_load4(p); wb=qwen_load4(p+16);
+            wc=qwen_load4(p+32); wd=qwen_load4(p+48); wt=*(const uint32_t *)(p+64);
+        } else if (tid < BM) { wa=wb=wc=wd=make_uint4(0,0,0,0); wt=0; }
+#pragma unroll
+        for (int i=0; i<B_ITEMS; ++i) {
+            const int c=tid+i*256, row=t0+(c>>3), col=(c&7)*8;
+            bx[i]=row<T ? *(const uint4 *)(X+size_t(row)*K+ks*BK+col) : make_uint4(0,0,0,0);
+        }
+    };
+    auto store = [&]() {
+        if (tid<BM) qwen_bf16_q8_row(wa,wb,wc,wd,wt,(uint32_t *)(As+tid*LS));
+#pragma unroll
+        for (int i=0; i<B_ITEMS; ++i) {
+            const int c=tid+i*256;
+            *(uint4 *)(Bs+(c>>3)*LS+(c&7)*8)=bx[i];
+        }
+    };
+    v8f acc[TM][TN] = {};
+    load(0); store(); __syncthreads();
+    for (int ks=0; ks<K/BK; ++ks) {
+        if (ks+1<K/BK) load(ks+1);
+#pragma unroll
+        for (int kk=0; kk<BK; kk+=16) {
+            v16s a[TM], b[TN];
+#pragma unroll
+            for (int i=0; i<TM; ++i) {
+                const uint16_t * p=As+(wm*WTM+i*16+(lane&15))*LS+kk;
+                a[i]=__builtin_bit_cast(v16s,(uint4[2]){*(const uint4 *)p,*(const uint4 *)(p+8)});
+            }
+#pragma unroll
+            for (int j=0; j<TN; ++j) {
+                const uint16_t * p=Bs+(wn*WTN+j*16+(lane&15))*LS+kk;
+                b[j]=__builtin_bit_cast(v16s,(uint4[2]){*(const uint4 *)p,*(const uint4 *)(p+8)});
+            }
+#pragma unroll
+            for (int i=0; i<TM; ++i)
+#pragma unroll
+                for (int j=0; j<TN; ++j)
+                    acc[i][j]=__builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(b[j],a[i],acc[i][j]);
+        }
+        __syncthreads();
+        if (ks+1<K/BK) store();
+        __syncthreads();
+    }
+    // Reuse dead activation LDS for the fork's coalesced F32 epilogue.
+    float * stg=reinterpret_cast<float *>(Bs)+wave*256;
+#pragma unroll
+    for (int i=0; i<TM; ++i) {
+        const int m=m0+wm*WTM+i*16;
+#pragma unroll
+        for (int j=0; j<TN; ++j) {
+#pragma unroll
+            for (int e=0; e<8; ++e) stg[(2*e+(lane>>4))*16+(lane&15)]=acc[i][j][e];
+            __syncthreads();
+            const int n=lane>>1, half=lane&1, t=t0+wn*WTN+j*16+n;
+            if (t<T && m+half*8<M) {
+                const float4 a=*(const float4 *)(stg+n*16+half*8);
+                const float4 b=*(const float4 *)(stg+n*16+half*8+4);
+                *(float4 *)(D+size_t(t)*M+m+half*8)=a;
+                *(float4 *)(D+size_t(t)*M+m+half*8+4)=b;
+            }
+            __syncthreads();
+        }
+    }
+#endif
+}
+
+// Fork gate/mix layout, but residual inputs, gate accumulator and result all
+// remain F32. Only matrix operands use the opt-in BF16 policy.
+static __global__ __launch_bounds__(256,2) void qwen_bf16_gate_mix(
+        const uint8_t * W,const uint16_t * Lo,const float * Xn,float * Out,
+        int E,int K,int T,float scale) {
+#if defined(__HIP_DEVICE_COMPILE__) && !defined(RDNA3)
+    NO_DEVICE_CODE;
+#else
+    constexpr int CH=32,BN=128,LS=72;
+    __shared__ __align__(16) uint16_t As[128*LS],Bs[BN*LS];
+    const int tid=threadIdx.x,lane=tid&31,wave=tid>>5,wm=wave&1,wn=wave>>1;
+    const int e0=blockIdx.x*CH,t0=blockIdx.y*BN;
+    const size_t row_bytes=size_t(K/32)*34;
+    uint4 a{},b{},c{},d{},bx[4]; uint32_t tail=0;
+    auto load=[&](int ks) {
+        if (tid<128) {
+            const int row=(tid/CH)*E+e0+tid%CH;
+            const uint8_t * p=W+size_t(row)*row_bytes+size_t(ks)*68;
+            a=qwen_load4(p);b=qwen_load4(p+16);c=qwen_load4(p+32);d=qwen_load4(p+48);
+            tail=*(const uint32_t *)(p+64);
+        }
+#pragma unroll
+        for (int i=0;i<4;++i) {
+            const int idx=tid+i*256,t=t0+(idx>>3);
+            bx[i]=t<T ? *(const uint4 *)(Lo+size_t(t)*K+ks*64+(idx&7)*8) : make_uint4(0,0,0,0);
+        }
+    };
+    auto store=[&]() {
+        if (tid<128) qwen_bf16_q8_row(a,b,c,d,tail,(uint32_t *)(As+tid*LS));
+#pragma unroll
+        for (int i=0;i<4;++i) {
+            const int idx=tid+i*256;
+            *(uint4 *)(Bs+(idx>>3)*LS+(idx&7)*8)=bx[i];
+        }
+    };
+    v8f acc[4][2]={};
+    load(0);store();__syncthreads();
+    for (int ks=0;ks<K/64;++ks) {
+        if (ks+1<K/64) load(ks+1);
+#pragma unroll
+        for (int kk=0;kk<64;kk+=16) {
+            v16s av[4],bv[2];
+#pragma unroll
+            for (int stream=0;stream<4;++stream) {
+                const uint16_t * p=As+(stream*CH+wm*16+(lane&15))*LS+kk;
+                av[stream]=__builtin_bit_cast(v16s,(uint4[2]){*(const uint4 *)p,*(const uint4 *)(p+8)});
+            }
+#pragma unroll
+            for (int j=0;j<2;++j) {
+                const uint16_t * p=Bs+(wn*32+j*16+(lane&15))*LS+kk;
+                bv[j]=__builtin_bit_cast(v16s,(uint4[2]){*(const uint4 *)p,*(const uint4 *)(p+8)});
+            }
+#pragma unroll
+            for (int stream=0;stream<4;++stream)
+#pragma unroll
+                for (int j=0;j<2;++j) acc[stream][j]=__builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(bv[j],av[stream],acc[stream][j]);
+        }
+        __syncthreads();if (ks+1<K/64) store();__syncthreads();
+    }
+    const int ch=e0+wm*16+(lane&15);
+#pragma unroll
+    for (int j=0;j<2;++j) {
+#pragma unroll
+        for (int e=0;e<8;++e) {
+            const int t=t0+wn*32+j*16+2*e+(lane>>4);
+            if (t<T) {
+                float sum=0;
+#pragma unroll
+                for (int stream=0;stream<4;++stream) {
+                    const float gate=1.0f/(1.0f+expf(-acc[stream][j][e]));
+                    sum+=Xn[(size_t(t)*4+stream)*E+ch]*gate;
+                }
+                Out[size_t(t)*E+ch]=scale*sum;
+            }
+        }
+    }
+#endif
+}
+
+} // namespace
+#endif
+
+bool ggml_cuda_qwen4exp_mmb(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * w, const ggml_tensor * x, ggml_tensor * out) {
+#if defined(GGML_USE_HIP)
+    if (!ggml_cuda_qwen4exp_fast_math(ctx) ||
+            ggml_cuda_info().devices[ctx.device].cc != GGML_CUDA_CC_OFFSET_AMD+0x1151 ||
+            w->type != GGML_TYPE_Q8_0 || ggml_get_op_params_i32(out,1) != GGML_HINT_QWEN4EXP_Q8_DECODE ||
+            ggml_get_op_params_i32(out,0) != GGML_PREC_DEFAULT ||
+            ggml_get_op_params_i32(out,3) != GGML_PREC_DEFAULT ||
+            x->type != GGML_TYPE_F32 || out->type != GGML_TYPE_F32 ||
+            !ggml_is_contiguous(w) || !ggml_is_contiguous(x) || !ggml_is_contiguous(out) ||
+            w->ne[2]!=1 || w->ne[3]!=1 || x->ne[2]!=1 || x->ne[3]!=1 || out->ne[2]!=1 || out->ne[3]!=1 ||
+            w->ne[0]!=x->ne[0] || w->ne[1]!=out->ne[0] || x->ne[1]!=out->ne[1] ||
+            w->ne[0]%64 || w->ne[1]%32 || x->ne[1]<512 ||
+            w->ne[0]>32768 || w->ne[1]>32768 || x->ne[1]>32768 ||
+            uintptr_t(x->data)%16 || uintptr_t(w->data)%16 || uintptr_t(out->data)%16) return false;
+    const int K=w->ne[0], M=w->ne[1], T=x->ne[1];
+    const size_t n=size_t(K)*T;
+    ggml_cuda_pool_alloc<uint16_t> input(ctx.pool(),n);
+    qwen_bf16_input<<<(n+2047)/2048,256,0,ctx.stream()>>>((const float *)x->data,input.get(),n);
+    if (M>=6144 && K>=2560) {
+        qwen_q8_bf16_wmma<256,64><<<dim3((M+127)/128,(T+255)/256),256,0,ctx.stream()>>>(
+            (const uint8_t *)w->data,input.get(),(float *)out->data,M,K,T);
+    } else {
+        qwen_q8_bf16_wmma<128,32><<<dim3((M+127)/128,(T+127)/128),256,0,ctx.stream()>>>(
+            (const uint8_t *)w->data,input.get(),(float *)out->data,M,K,T);
+    }
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+#else
+    GGML_UNUSED(ctx); GGML_UNUSED(w); GGML_UNUSED(x); GGML_UNUSED(out);
+    return false;
+#endif
+}
+
+bool ggml_cuda_qwen4exp_gate_mix(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * matrix,const ggml_tensor * normalized,ggml_tensor * out) {
+#if defined(GGML_USE_HIP)
+    const auto * w=matrix->src[0],*lo=matrix->src[1];
+    if (!ggml_cuda_qwen4exp_fast_math(ctx) || ggml_cuda_info().devices[ctx.device].cc!=GGML_CUDA_CC_OFFSET_AMD+0x1151 ||
+            matrix->op!=GGML_OP_MUL_MAT || matrix->op_params[1]!=GGML_HINT_QWEN4EXP_Q8_DECODE ||
+            matrix->op_params[0]!=GGML_PREC_DEFAULT || matrix->op_params[3]!=GGML_PREC_DEFAULT ||
+            !w || !lo || w->type!=GGML_TYPE_Q8_0 || lo->type!=GGML_TYPE_F32 ||
+            normalized->type!=GGML_TYPE_F32 || out->type!=GGML_TYPE_F32 ||
+            !ggml_is_contiguous(w) || !ggml_is_contiguous(lo) || !ggml_is_contiguous(normalized) || !ggml_is_contiguous(out)) return false;
+    const int64_t E=out->ne[0],K=w->ne[0],T=out->ne[1];
+    if (E<32 || E>8192 || E%32 || K<64 || K>4096 || K%64 || T<512 || T>4096 ||
+            w->ne[1]!=4*E || w->ne[2]!=1 || w->ne[3]!=1 ||
+            lo->ne[0]!=K || lo->ne[1]!=T || lo->ne[2]!=1 || lo->ne[3]!=1 ||
+            normalized->ne[0]!=E || normalized->ne[1]!=4 || normalized->ne[2]!=T || normalized->ne[3]!=1 ||
+            out->ne[2]!=1 || out->ne[3]!=1 || out->op!=GGML_OP_DSV4_HC_PRE || out->op_params[1]!=1 ||
+            uintptr_t(w->data)%4 || uintptr_t(lo->data)%16 || uintptr_t(normalized->data)%4 || uintptr_t(out->data)%4) return false;
+    float scale;memcpy(&scale,out->op_params,sizeof(scale));
+    ggml_cuda_pool_alloc<uint16_t> input(ctx.pool(),size_t(K)*T);
+    qwen_bf16_input<<<(K*T+2047)/2048,256,0,ctx.stream()>>>((const float *)lo->data,input.get(),K*T);
+    qwen_bf16_gate_mix<<<dim3(E/32,(T+127)/128),256,0,ctx.stream()>>>(
+        (const uint8_t *)w->data,input.get(),(const float *)normalized->data,(float *)out->data,E,K,T,scale);
+    CUDA_CHECK(cudaGetLastError());return true;
+#else
+    GGML_UNUSED(ctx);GGML_UNUSED(matrix);GGML_UNUSED(normalized);GGML_UNUSED(out);return false;
+#endif
+}
