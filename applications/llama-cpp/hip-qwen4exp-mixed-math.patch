+    const uint16_t * converted=input.get();
+    mmb_cvt_f32_bf16<<<(nx+2047)/2048,256,0,ctx.stream()>>>((const float *)x->data, input.get(), nx);
+    ggml_cuda_pool_alloc<int32_t> source(ctx.pool(),rows), dest(ctx.pool(),rows), bounds(ctx.pool(),E+1);
+    if (!ggml_cuda_qwen_mm_ids(ctx,(const int32_t *)ids->data,source.get(),dest.get(),bounds.get(),
+            E,T,used,channels,ids->nb[1]/sizeof(int32_t),x->nb[2]/x->nb[1],false,ctx.stream())) {
+        ggml_cuda_launch_mm_ids_helper((const int32_t *)ids->data,source.get(),dest.get(),bounds.get(),
+            E,T,used,channels,ids->nb[1]/sizeof(int32_t),x->nb[2]/x->nb[1],false,ctx.stream());
+    }
+    constexpr int BN=128, SMALL=32, THRESH=128;
+    const int nb=rows/BN+E+1, ns=E*((THRESH+SMALL-1)/SMALL)+1;
+    ggml_cuda_pool_alloc<uint32_t> big(ctx.pool(),nb), small(ctx.pool(),ns);
+    mmb_build_desc2<<<1,1024,0,ctx.stream()>>>(bounds.get(),big.get(),small.get(),E,nb,ns,BN,SMALL,THRESH);
+    if(w->type==GGML_TYPE_Q8_0) {
