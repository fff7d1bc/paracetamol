+++ b/ggml/src/ggml-cuda/qwen4exp-f32.cu
@@ -0,0 +1,111 @@
+// Opt-in extraction from halo-box/strix-llama.cpp, MIT,
+// 7a9196dad8b13b70fb3420886aadaf98fc09b849. Not a default precision policy.
+#include "qwen4exp-mmb.cuh"
+#if defined(GGML_USE_HIP)
+namespace {
+typedef short v16s __attribute__((ext_vector_type(16)));
+typedef float v8f __attribute__((ext_vector_type(8)));
+constexpr int MMB_NT = 256;
+// F32 storage, F16 matrix operands, F32 accumulation. This deliberately does
+// not claim the compensated arithmetic suggested by the fork's "f32split" name.
+__device__ __forceinline__ uint16_t qwen_half(float x) {
+    return __builtin_bit_cast(uint16_t, (_Float16) x);
+}
+template <int BM, int BN, int WTM, int WTN>
+__global__ void __launch_bounds__(MMB_NT, 2)
+qwen_f32_half_kernel(const float * __restrict__ W, const float * __restrict__ X, float * __restrict__ D, const int M, const int K, const int T) {
+#if defined(__HIP_DEVICE_COMPILE__) && !defined(RDNA3)
+    // This extraction is compiled for the RDNA3 instruction shape only.
+    NO_DEVICE_CODE;
+#else
+    constexpr int BKs = 32, LS = BKs + 8, WAVES_M = BM / WTM, TM = WTM / 16, TN = WTN / 16;
+    static_assert(WAVES_M * (BN / WTN) * 32 == MMB_NT, "tile must use every wave");
+    __shared__ __align__(16) uint16_t Ah[BM * LS], Bh[BN * LS];
+    const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5, wm = wave % WAVES_M, wn = wave / WAVES_M;
+    const int m0 = blockIdx.x * BM, t0 = blockIdx.y * BN;
+    v8f acc[TM][TN];
+#pragma unroll
+    for (int i = 0; i < TM; ++i)
+#pragma unroll
+        for (int j = 0; j < TN; ++j)
+#pragma unroll
+            for (int e = 0; e < 8; ++e) acc[i][j][e] = 0.f;
+    constexpr int A_CH = BM * BKs / 4, B_CH = BN * BKs / 4;
+    for (int k0 = 0; k0 < K; k0 += BKs) {
+        for (int idx = tid; idx < A_CH; idx += MMB_NT) { const int row = idx >> 3, c4 = (idx & 7) * 4; const int m = m0 + row;
+            float4 v = make_float4(0.f,0.f,0.f,0.f); if (m < M) v = *(const float4 *)(W + (size_t) m * K + k0 + c4);
+            const uint16_t h[4] = {qwen_half(v.x), qwen_half(v.y), qwen_half(v.z), qwen_half(v.w)};
+            *(uint2 *)(Ah + row * LS + c4) = make_uint2((uint32_t)h[0] | ((uint32_t)h[1] << 16), (uint32_t)h[2] | ((uint32_t)h[3] << 16));
+        }
+        for (int idx = tid; idx < B_CH; idx += MMB_NT) { const int row = idx >> 3, c4 = (idx & 7) * 4; const int t = t0 + row;
+            float4 v = make_float4(0.f,0.f,0.f,0.f); if (t < T) v = *(const float4 *)(X + (size_t) t * K + k0 + c4);
+            const uint16_t h[4] = {qwen_half(v.x), qwen_half(v.y), qwen_half(v.z), qwen_half(v.w)};
+            *(uint2 *)(Bh + row * LS + c4) = make_uint2((uint32_t)h[0] | ((uint32_t)h[1] << 16), (uint32_t)h[2] | ((uint32_t)h[3] << 16));
+        }
+        __syncthreads();
+        const int r = lane & 15;
+#pragma unroll
+        for (int kk = 0; kk < BKs; kk += 16) {
+            v16s ah[TM], bh[TN];
+#pragma unroll
+            for (int i = 0; i < TM; ++i) { const int off = (wm * WTM + i * 16 + r) * LS + kk;
+                ah[i] = __builtin_bit_cast(v16s, (uint4[2]){*(const uint4 *)(Ah + off), *(const uint4 *)(Ah + off + 8)});
+            }
+#pragma unroll
+            for (int j = 0; j < TN; ++j) { const int off = (wn * WTN + j * 16 + r) * LS + kk;
+                bh[j] = __builtin_bit_cast(v16s, (uint4[2]){*(const uint4 *)(Bh + off), *(const uint4 *)(Bh + off + 8)});
+            }
+#pragma unroll
+            for (int i = 0; i < TM; ++i)
+#pragma unroll
+                for (int j = 0; j < TN; ++j) {
+                    acc[i][j] = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(bh[j], ah[i], acc[i][j]);
+                }
+        }
+        __syncthreads();
+    }
+    const int cm = lane & 15, cn = lane >> 4;
+#pragma unroll
+    for (int i = 0; i < TM; ++i) { const int m = m0 + wm * WTM + i * 16 + cm; if (m >= M) continue;
+#pragma unroll
+        for (int j = 0; j < TN; ++j)
+#pragma unroll
+            for (int e = 0; e < 8; ++e) { const int t = t0 + wn * WTN + j * 16 + 2 * e + cn; if (t < T) D[(size_t) t * M + m] = acc[i][j][e]; } }
+#endif
+}
+
+
+} // namespace
+#endif
+
+bool ggml_cuda_qwen4exp_f32_wmma(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * w, const ggml_tensor * x, ggml_tensor * out) {
+#if defined(GGML_USE_HIP)
+    // The accepted mode uses F16 operands with F32 accumulation.
+    if (!ggml_cuda_qwen4exp_fast_math(ctx) ||
+            ggml_cuda_info().devices[ctx.device].cc != GGML_CUDA_CC_OFFSET_AMD+0x1151 ||
+            w->type != GGML_TYPE_F32 || ggml_get_op_params_i32(out,1) != GGML_HINT_QWEN4EXP_F32 ||
+            ggml_get_op_params_i32(out,0) != GGML_PREC_DEFAULT ||
+            ggml_get_op_params_i32(out,3) != GGML_PREC_DEFAULT ||
+            x->type != GGML_TYPE_F32 || out->type != GGML_TYPE_F32 ||
+            !ggml_is_contiguous(w) || !ggml_is_contiguous(x) || !ggml_is_contiguous(out) ||
+            w->ne[2]!=1 || w->ne[3]!=1 || x->ne[2]!=1 || x->ne[3]!=1 || out->ne[2]!=1 || out->ne[3]!=1 ||
+            w->ne[0]!=x->ne[0] || w->ne[1]!=out->ne[0] || x->ne[1]!=out->ne[1] ||
+            w->ne[0]%32 || w->ne[1]<1 || x->ne[1]<256 ||
+            w->ne[0]>32768 || w->ne[1]>1024 || x->ne[1]>32768 ||
+            uintptr_t(x->data)%16 || uintptr_t(w->data)%16 || uintptr_t(out->data)%16) return false;
+    const int K=w->ne[0], M=w->ne[1], T=x->ne[1];
+    if (M <= 64) {
+        qwen_f32_half_kernel<64,128,16,64><<<dim3((M+63)/64,(T+127)/128),256,0,ctx.stream()>>>(
+            (const float *) w->data, (const float *) x->data, (float *) out->data, M, K, T);
+    } else {
+        qwen_f32_half_kernel<128,128,32,64><<<dim3((M+127)/128,(T+127)/128),256,0,ctx.stream()>>>(
+            (const float *) w->data, (const float *) x->data, (float *) out->data, M, K, T);
+    }
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+#else
+    GGML_UNUSED(ctx); GGML_UNUSED(w); GGML_UNUSED(x); GGML_UNUSED(out);
+    return false;
+#endif
+}
