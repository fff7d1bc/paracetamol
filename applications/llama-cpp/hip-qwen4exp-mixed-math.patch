+bool ggml_cuda_qwen4exp_expert_glu(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * gate, const ggml_tensor * up, ggml_tensor * out) {
+#if defined(GGML_USE_HIP)
+    if (!ggml_cuda_qwen4exp_fast_math(ctx) ||
+            ggml_cuda_info().devices[ctx.device].cc != GGML_CUDA_CC_OFFSET_AMD+0x1151 ||
+            gate->op!=GGML_OP_MUL_MAT_ID || up->op!=GGML_OP_MUL_MAT_ID ||
+            ggml_get_op_params_i32(gate,1)!=GGML_HINT_SMALL_MOE_TILES ||
+            ggml_get_op_params_i32(up,1)!=GGML_HINT_SMALL_MOE_TILES ||
+            ggml_get_op_params_i32(gate,0)!=GGML_PREC_DEFAULT || ggml_get_op_params_i32(up,0)!=GGML_PREC_DEFAULT ||
+            ggml_get_op_params_i32(gate,3)!=GGML_PREC_DEFAULT || ggml_get_op_params_i32(up,3)!=GGML_PREC_DEFAULT ||
+            gate->src[1]!=up->src[1] || gate->src[2]!=up->src[2] ||
+            out->op!=GGML_OP_GLU || ggml_get_glu_op(out)!=GGML_GLU_OP_SWIGLU ||
+            ggml_get_op_params_i32(out,1)!=0 || out->src[0]!=gate || out->src[1]!=up) return false;
+    const auto * gw=gate->src[0], * uw=up->src[0], * x=gate->src[1], * ids=gate->src[2];
+    if ((gw->type!=GGML_TYPE_Q4_K && gw->type!=GGML_TYPE_Q5_K) || uw->type!=gw->type ||
+            !ggml_are_same_shape(gw,uw) || !ggml_are_same_stride(gw,uw) ||
+            x->type!=GGML_TYPE_F32 || out->type!=GGML_TYPE_F32 || ids->type!=GGML_TYPE_I32 ||
+            !ggml_is_contiguous(gw) || !ggml_is_contiguous(uw) || !ggml_is_contiguous(x) ||
+            !ggml_is_contiguous(out) || !ggml_are_same_shape(gate,up) || !ggml_are_same_shape(gate,out) ||
+            gw->ne[3]!=1 || x->ne[3]!=1 || out->ne[3]!=1 || ids->ne[2]!=1 || ids->ne[3]!=1 ||
+            ids->nb[0]!=sizeof(int32_t) || ids->nb[1]%sizeof(int32_t) ||
+            gw->ne[0]%256 || gw->ne[1]%32 || gw->ne[0]>10240 || gw->ne[1]>4096 ||
+            gw->ne[2]<1 || gw->ne[2]>1024 || ids->ne[0]<1 || ids->ne[0]>16 || ids->ne[0]>gw->ne[2] ||
+            ids->ne[1]<256 || ids->ne[1]>4096 ||
+            x->ne[0]!=gw->ne[0] || (x->ne[1]!=1 && x->ne[1]!=ids->ne[0]) || x->ne[2]!=ids->ne[1] ||
+            out->ne[0]!=gw->ne[1] || out->ne[1]!=ids->ne[0] || out->ne[2]!=ids->ne[1] ||
+            uintptr_t(gw->data)%16 || uintptr_t(uw->data)%16 || uintptr_t(x->data)%16 || uintptr_t(out->data)%16) return false;
+    const int K=gw->ne[0], M=gw->ne[1], E=gw->ne[2], T=ids->ne[1], used=ids->ne[0], channels=x->ne[1];
+    const int rows=used*T;
+    const size_t nx=size_t(K)*channels*T;
+    ggml_cuda_pool_alloc<uint16_t> input(ctx.pool(),nx);
+    const uint16_t * converted=input.get();
+    mmb_cvt_f32_bf16<<<(nx+2047)/2048,256,0,ctx.stream()>>>((const float *)x->data, input.get(), nx);
+    ggml_cuda_pool_alloc<int32_t> source(ctx.pool(),rows), dest(ctx.pool(),rows), bounds(ctx.pool(),E+1);
+    if (!ggml_cuda_qwen_mm_ids(ctx,(const int32_t *)ids->data,source.get(),dest.get(),bounds.get(),
+            E,T,used,channels,ids->nb[1]/sizeof(int32_t),x->nb[2]/x->nb[1],false,ctx.stream())) {
+        ggml_cuda_launch_mm_ids_helper((const int32_t *)ids->data,source.get(),dest.get(),bounds.get(),
+            E,T,used,channels,ids->nb[1]/sizeof(int32_t),x->nb[2]/x->nb[1],false,ctx.stream());
+    }
+    constexpr int BN=128, SMALL=32, THRESH=128;
+    const int nb=rows/BN+E+1, ns=E*((THRESH+SMALL-1)/SMALL)+1;
+    ggml_cuda_pool_alloc<uint32_t> big(ctx.pool(),nb), small(ctx.pool(),ns);
+    mmb_build_desc2<<<1,1024,0,ctx.stream()>>>(bounds.get(),big.get(),small.get(),E,nb,ns,BN,SMALL,THRESH);
+    if(gw->type==GGML_TYPE_Q5_K) {
+        mmb_routed_glu_kernel<64,128,32,32,32+GGML_TYPE_Q5_K><<<dim3((M+63)/64,nb),256,0,ctx.stream()>>>(
+            (const uint8_t *)gw->data,(const uint8_t *)uw->data,gw->nb[2],converted,(float *)out->data,
+            source.get(),dest.get(),bounds.get(),big.get(),M,K);
+        mmb_routed_glu_kernel<64,32,16,16,32+GGML_TYPE_Q5_K><<<dim3((M+63)/64,ns),256,0,ctx.stream()>>>(
+            (const uint8_t *)gw->data,(const uint8_t *)uw->data,gw->nb[2],converted,(float *)out->data,
+            source.get(),dest.get(),bounds.get(),small.get(),M,K);
+        CUDA_CHECK(cudaGetLastError());
+        return true;
+    }
+    mmb_routed_glu_kernel<64,128,32,32><<<dim3((M+63)/64,nb),256,0,ctx.stream()>>>(
+        (const uint8_t *)gw->data,(const uint8_t *)uw->data,gw->nb[2],converted,(float *)out->data,
+        source.get(),dest.get(),bounds.get(),big.get(),M,K);
+    mmb_routed_glu_kernel<64,32,16,16><<<dim3((M+63)/64,ns),256,0,ctx.stream()>>>(
+        (const uint8_t *)gw->data,(const uint8_t *)uw->data,gw->nb[2],converted,(float *)out->data,
+        source.get(),dest.get(),bounds.get(),small.get(),M,K);
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+#else
+    GGML_UNUSED(ctx); GGML_UNUSED(gate); GGML_UNUSED(up); GGML_UNUSED(out);
+    return false;
+#endif
+}
