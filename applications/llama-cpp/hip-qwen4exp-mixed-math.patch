+            !ggml_is_contiguous(w) || !ggml_is_contiguous(x) || !ggml_is_contiguous(out) ||
+            w->ne[3]!=1 || x->ne[3]!=1 || out->ne[3]!=1 || ids->ne[2]!=1 || ids->ne[3]!=1 ||
+            ids->nb[0]!=sizeof(int32_t) || ids->nb[1]%sizeof(int32_t) ||
+            w->ne[0]%64 || w->ne[1]%32 || w->ne[0]>10240 || w->ne[1]>4096 ||
+            w->ne[2]<1 || w->ne[2]>1024 || ids->ne[0]<1 || ids->ne[0]>16 || ids->ne[0]>w->ne[2] ||
+            ids->ne[1]<256 || ids->ne[1]>4096 ||
+            x->ne[0]!=w->ne[0] || (x->ne[1]!=1 && x->ne[1]!=ids->ne[0]) || x->ne[2]!=ids->ne[1] ||
+            out->ne[0]!=w->ne[1] || out->ne[1]!=ids->ne[0] || out->ne[2]!=ids->ne[1] ||
