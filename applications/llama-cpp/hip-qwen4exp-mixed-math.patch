+            ggml_get_op_params_i32(out,1)!=GGML_HINT_SMALL_MOE_TILES ||
+            ggml_get_op_params_i32(out,0)!=GGML_PREC_DEFAULT ||
+            ggml_get_op_params_i32(out,3)!=GGML_PREC_DEFAULT ||
