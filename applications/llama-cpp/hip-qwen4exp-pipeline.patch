 }
 
+#if defined(GGML_USE_HIP)
+static bool qsa_fusion_enabled(const ggml_backend_cuda_context * ctx, const char * flag) {
+    const char * graph = getenv("PARACETAMOL_QWEN4EXP_QSA_GRAPH");
+    const char * score = getenv(flag);
