+        auto * weights = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 4, tokens);
+        auto * gamma = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, embd, 4);
+        auto branch = [&](bool marked) {
+            auto * post = ggml_dsv4_hc_post(ctx, x, res, weights, nullptr);
+            if (marked) ggml_set_name(post, "qwen4exp_hc_combine");
+            auto * norm = ggml_rms_norm(ctx, post, 1e-6f);
+            auto * result = ggml_mul(ctx, norm, gamma);
+            if (marked) ggml_set_name(result, "qwen4exp_hc_norm");
+            auto * output = ggml_concat(ctx, ggml_reshape_1d(ctx, result, embd*4*tokens),
+                ggml_reshape_1d(ctx, post, embd*4*tokens), 0);
+            if (extra_reader) output = ggml_concat(ctx, output,
+                ggml_reshape_1d(ctx, ggml_sqr(ctx, norm), embd*4*tokens), 0);
+            return output;
+        };
+        auto * fast = branch(true);
+        auto * original = branch(false);
+        return ggml_sub(ctx, fast, original);
+    }
