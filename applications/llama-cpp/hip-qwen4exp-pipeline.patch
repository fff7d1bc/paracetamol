index 000000000..dcc736d25
--- /dev/null
+++ b/ggml/src/ggml-cuda/qwen4exp-mmq-prefetch.cu
@@ -0,0 +1,26 @@
+// Private static kernel instantiations. Do not define this for the ordinary
+// MMQ translation units: the smaller Q8 tiles belong only to hinted Qwen4exp.
+#define GGML_CUDA_MMQ_QWEN4EXP
+#include "mmq.cuh"
+
+bool ggml_cuda_mmq_qwen_q8(ggml_backend_cuda_context & ctx, const mmq_args & a, cudaStream_t stream) {
+#if defined(GGML_USE_HIP)
+    const char * enabled = getenv("PARACETAMOL_QWEN4EXP_MMQ_PREFETCH");
+    const auto & device = ggml_cuda_info().devices[ctx.device];
+    if ((enabled && strcmp(enabled, "0") == 0) || a.type_x != GGML_TYPE_Q8_0 ||
+            a.fusion.gate || a.ids_dst || a.nrows_x % 64 || a.ncols_max < 32 ||
+            device.cc != GGML_CUDA_CC_OFFSET_AMD + 0x1151) return false;
+    // Keep upstream's query-column selection. Only this translation unit uses
+    // the fork's smaller row tiles, paired with its register-prefetched loads.
+    const int best = a.J_best;
+    const auto config = ggml_cuda_mmq_get_config(a.type_x, best, false, device.cc, GGML_PREC_Q8);
+    if (config.type == GGML_TYPE_COUNT || mmq_get_nbytes_shared(config, device.cc) > device.smpbo) return false;
+    if (best == 48) launch_mul_mat_q<GGML_TYPE_Q8_0, 48, false, GGML_PREC_Q8, false, true>(ctx, a, stream);
+    else if (best == 128) launch_mul_mat_q<GGML_TYPE_Q8_0, 128, false, GGML_PREC_Q8, false, true>(ctx, a, stream);
+    else return false;
+    return true;
+#else
+    GGML_UNUSED(ctx); GGML_UNUSED(a); GGML_UNUSED(stream);
+    return false;
+#endif
+}
diff --git a/ggml/src/ggml-cuda/qwen4exp-mmq-prefetch.cuh b/ggml/src/ggml-cuda/qwen4exp-mmq-prefetch.cuh
new file mode 100644
index 000000000..3bdf70580
--- /dev/null
+++ b/ggml/src/ggml-cuda/qwen4exp-mmq-prefetch.cuh
@@ -0,0 +1,99 @@
+// Adapted from halo-box/strix-llama.cpp, MIT, commit
+// 7a9196dad8b13b70fb3420886aadaf98fc09b849. Used only by opted-in Q8 tiles.
+#pragma once
+
+// Register-staged variant of the Q8_0 tile loader used for software prefetching on RDNA3.5:
+//     the global loads for the next K iteration are issued into registers while the current tile is consumed,
+//     then written to shared memory with exactly the same layout as ggml_cuda_mmq_load_tiles_q8_0.
+template <ggml_type type, int J, bool fallback> struct ggml_cuda_mmq_x_regs_q8_0 {
+    // Only instantiated for RDNA3.5 (wave32) device code; the host pass needs constant sizes.
+    static constexpr int warp_size       = WARP_SIZE;
+    static constexpr int nwarps          = ggml_cuda_mmq_get_nthreads(type, J, fallback, GGML_PREC_Q8) / warp_size;
+    static constexpr int I               = ggml_cuda_mmq_get_I(type, J, fallback, GGML_PREC_Q8);
+    static constexpr int threads_per_row = 32;
+    static constexpr int nrows           = warp_size / threads_per_row;
+    static constexpr int rows_per_step   = nrows*nwarps;
+    static constexpr int n_qs            = (I + rows_per_step - 1) / rows_per_step;
+    static constexpr int blocks_per_tile_x_row = 2*MMQ_TILE_NE_K / QI8_0;
+    static constexpr int rows_per_warp   = warp_size / blocks_per_tile_x_row;
+    static constexpr int d_rows_per_step = nwarps*rows_per_warp;
+    static constexpr int n_d             = (I + d_rows_per_step - 1) / d_rows_per_step;
+
+    int  qs[2*n_qs];
+    half d[n_d];
+};
+
+template <ggml_type type, int J, bool fallback> static __device__ __forceinline__ void ggml_cuda_mmq_load_tiles_q8_0_regs(
+        const char * __restrict__ x, ggml_cuda_mmq_x_regs_q8_0<type, J, fallback> & r, const int kbx0, const int i_max, const int stride) {
+    using R = ggml_cuda_mmq_x_regs_q8_0<type, J, fallback>;
+    static_assert(R::warp_size == ggml_cuda_get_physical_warp_size(), "register-staged Q8_0 loader assumes wave32");
+
+    const int txi  = R::warp_size > R::threads_per_row ? threadIdx.x % R::threads_per_row : threadIdx.x;
+    const int kbx  = txi / QI8_0;
+    const int kqsx = txi % QI8_0;
+
+#pragma unroll
+    for (int i0 = 0; i0 < R::I; i0 += R::rows_per_step) {
+        int i = i0 + (R::nrows == 1 ? threadIdx.y : threadIdx.y*R::nrows + threadIdx.x/R::threads_per_row);
+
+        if (fallback) {
+            i = min(i, i_max);
+        }
+
+        const block_q8_0 * bxi = (const block_q8_0 *) x + kbx0 + i*stride + kbx;
+
+        r.qs[2*(i0/R::rows_per_step) + 0] = get_int_b2(bxi[0].qs,                   kqsx);
+        r.qs[2*(i0/R::rows_per_step) + 1] = get_int_b2(bxi[MMQ_TILE_NE_K/QI8_0].qs, kqsx);
+    }
+
+    const int kbxd = threadIdx.x % R::blocks_per_tile_x_row;
+
+#pragma unroll
+    for (int i0 = 0; i0 < R::I; i0 += R::d_rows_per_step) {
+        int i = i0 + threadIdx.y*R::rows_per_warp + threadIdx.x/R::blocks_per_tile_x_row;
+
+        if (fallback) {
+            i = min(i, i_max);
+        }
+
+        const block_q8_0 * bxi = (const block_q8_0 *) x + kbx0 + i*stride + kbxd;
+
+        r.d[i0/R::d_rows_per_step] = bxi->d;
+    }
+}
+
+template <ggml_type type, int J, bool fallback> static __device__ __forceinline__ void ggml_cuda_mmq_store_tiles_q8_0_regs(
+        const ggml_cuda_mmq_x_regs_q8_0<type, J, fallback> & r, int * __restrict__ x_tile, const int i_max) {
+    using R = ggml_cuda_mmq_x_regs_q8_0<type, J, fallback>;
+    constexpr int sram_stride = ggml_cuda_mmq_get_sram_stride(type, J, fallback, GGML_PREC_Q8);
+
+    int   * x_qs = (int   *)  x_tile;
+    float * x_df = (float *) (x_tile + 2*MMQ_TILE_NE_K);
+
+    const int txi = R::warp_size > R::threads_per_row ? threadIdx.x % R::threads_per_row : threadIdx.x;
+
+#pragma unroll
+    for (int i0 = 0; i0 < R::I; i0 += R::rows_per_step) {
+        int i = i0 + (R::nrows == 1 ? threadIdx.y : threadIdx.y*R::nrows + threadIdx.x/R::threads_per_row);
+
+        if (fallback) {
+            i = min(i, i_max);
+        }
+
+        x_qs[i*sram_stride + 0             + txi] = r.qs[2*(i0/R::rows_per_step) + 0];
+        x_qs[i*sram_stride + MMQ_TILE_NE_K + txi] = r.qs[2*(i0/R::rows_per_step) + 1];
+    }
+
+    const int kbxd = threadIdx.x % R::blocks_per_tile_x_row;
+
+#pragma unroll
+    for (int i0 = 0; i0 < R::I; i0 += R::d_rows_per_step) {
+        int i = i0 + threadIdx.y*R::rows_per_warp + threadIdx.x/R::blocks_per_tile_x_row;
+
+        if (fallback) {
+            i = min(i, i_max);
+        }
+
+        x_df[i*sram_stride + kbxd] = r.d[i0/R::d_rows_per_step];
+    }
+}
diff --git a/ggml/src/ggml-cuda/qwen4exp-mmq.cu b/ggml/src/ggml-cuda/qwen4exp-mmq.cu
new file mode 100644
index 000000000..1eb4a0e3d
--- /dev/null
+++ b/ggml/src/ggml-cuda/qwen4exp-mmq.cu
@@ -0,0 +1,141 @@
+#include "mmq.cuh"
+#if defined(GGML_USE_HIP)
+// Compact routed tiles from halo-box/strix-llama.cpp at 7a9196d (MIT).
+// Keep the upstream dot product and tile geometry, only skip empty expert tiles.
+#define MMQ_ROUTED_MAX_EXPERTS 1024
+static constexpr int QWEN_MMQ_MAX_ROUTED_COLS = 32 * (UINT16_MAX + 1);
+template <int J>
+static __global__ void build_mmq_routed_descriptors(
+        const int32_t * expert_bounds, uint32_t * descriptors, int n_experts, int max_descriptors) {
+    __shared__ int tile_counts[MMQ_ROUTED_MAX_EXPERTS];
+    const int expert = threadIdx.x;
+
+    for (int i = expert; i < max_descriptors; i += blockDim.x) {
+        descriptors[i] = UINT32_MAX;
+    }
+
+    if (expert < n_experts) {
+        const int count = expert_bounds[expert + 1] - expert_bounds[expert];
+        tile_counts[expert] = (count + J - 1) / J;
+    }
+    __syncthreads();
+
+    if (expert < n_experts) {
+        int descriptor = 0;
+        for (int i = 0; i < expert; ++i) {
+            descriptor += tile_counts[i];
+        }
+        for (int jt = 0; jt < tile_counts[expert]; ++jt) {
+            descriptors[descriptor + jt] = uint32_t(expert) | (uint32_t(jt) << 16);
+        }
+    }
+}
+
+template <ggml_type type, int J, bool fallback>
+__launch_bounds__(ggml_cuda_mmq_get_nthreads(type, J, fallback, GGML_PREC_Q8), ggml_cuda_mmq_get_occupancy(type, J, fallback, GGML_PREC_Q8))
+static __global__ void mul_mat_q_routed_compact(
+        const char * __restrict__ x, const int * __restrict__ y, const int32_t * __restrict__ ids_dst,
+        const int32_t * __restrict__ expert_bounds, const uint32_t * __restrict__ descriptors,
+        const int max_descriptors, float * __restrict__ dst, const float * __restrict__ y_scale,
+        const uint3 blocks_per_ne00, const int nrows_x, const int stride_row_x, const int ncols_y, const int stride_col_dst,
+        const uint3 channel_ratio, const int stride_channel_x,
+        const uint3 sample_ratio, const int stride_sample_x) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int nwarps    = ggml_cuda_mmq_get_nthreads(type, J, fallback, GGML_PREC_Q8) / warp_size;
+    constexpr int I         = ggml_cuda_mmq_get_I(type, J, fallback, GGML_PREC_Q8);
+
+    const int wt = blockIdx.z;
+    const int it = blockIdx.x;
+
+    extern __shared__ int ids_dst_shared[];
+    for (int descriptor_idx = blockIdx.y; descriptor_idx < max_descriptors; descriptor_idx += gridDim.y) {
+        const uint32_t descriptor = descriptors[descriptor_idx];
+        if (descriptor == UINT32_MAX) {
+            return;
+        }
+
+        const int zt = descriptor & 0xFFFF;
+        const int jt = descriptor >> 16;
+        const int col_low  = expert_bounds[zt + 0];
+        const int col_high = expert_bounds[zt + 1];
+        const int col_diff = col_high - col_low;
+
+        if (descriptor_idx != int(blockIdx.y)) {
+            __syncthreads();
+        }
+#pragma unroll
+        for (int j0 = 0; j0 < J; j0 += nwarps * warp_size) {
+            const int j = j0 + threadIdx.y * warp_size + threadIdx.x;
+            if (j0 + nwarps * warp_size > J && j >= J) {
+                break;
+            }
+            ids_dst_shared[j] = jt * J + j < col_diff ? ids_dst[col_low + jt * J + j] : 0;
+        }
+        __syncthreads();
+
+        const int offset_x = fastdiv(wt, sample_ratio) * stride_sample_x +
+            fastdiv(zt, channel_ratio) * stride_channel_x + it * I * stride_row_x;
+        const int offset_y = (col_low + jt * J) * (sizeof(block_q8_1_mmq) / sizeof(int));
+        const int tile_x_max_i = nrows_x - it * I - 1;
+        const int tile_y_max_j = col_diff - jt * J - 1;
+        const float * y_scale_tile = y_scale ? y_scale + col_low + jt * J : nullptr;
+
+        constexpr bool fixup = false;
+        mul_mat_q_process_tile<type, J, fallback, fixup, GGML_PREC_Q8, false>
+            (x, nullptr, offset_x, y + offset_y, ids_dst_shared, dst + it * I, nullptr, y_scale_tile, GGML_GLU_OP_SWIGLU, 0.0f,
+             stride_row_x, ncols_y, stride_col_dst,
+             tile_x_max_i, tile_y_max_j, 0, blocks_per_ne00.z);
+    }
+}
+
+template <ggml_type type, int J>
+static void qwen_compact_mmq(ggml_backend_cuda_context & ctx, const mmq_args & a, cudaStream_t stream) {
+    static_assert((QWEN_MMQ_MAX_ROUTED_COLS - 1) / J <= UINT16_MAX, "packed tile index must fit");
+    const int cc = ggml_cuda_info().devices[ctx.device].cc;
+    const auto config = ggml_cuda_mmq_get_config(type, J, false, cc, GGML_PREC_Q8);
+    const int max_desc = (a.ncols_dst + J - 1) / J + a.nchannels_y;
+    ggml_cuda_pool_alloc<uint32_t> descriptors(ctx.pool(), max_desc);
+    build_mmq_routed_descriptors<J><<<1, MMQ_ROUTED_MAX_EXPERTS, 0, stream>>>(
+        a.expert_bounds, descriptors.get(), a.nchannels_y, max_desc);
+    const dim3 grid((a.nrows_x + config.I - 1) / config.I, (a.ncols_dst + J - 1) / J, 1);
+    const dim3 threads(32, config.nthreads / 32);
+    mul_mat_q_routed_compact<type, J, false><<<grid, threads, mmq_get_nbytes_shared(config, cc), stream>>>(
+        a.x, a.y, a.ids_dst, a.expert_bounds, descriptors.get(), max_desc, a.dst, a.y_scale,
+        init_fastdiv_values(a.ncols_x / ggml_cuda_type_traits<type>::qk),
+        a.nrows_x, a.stride_row_x, a.ncols_y, a.nrows_dst,
+        init_fastdiv_values(1), a.stride_channel_x, init_fastdiv_values(1), a.stride_sample_x);
+    CUDA_CHECK(cudaGetLastError());
+}
+#endif
+
+// The Strix fork favors smaller row tiles for these expert types. Use the
+// existing upstream J32/I64 kernels instead of changing global tile tables.
+// Only explicitly hinted Qwen4exp operations reach this optional path.
+bool ggml_cuda_mmq_small_moe(ggml_backend_cuda_context & ctx, const mmq_args & a, cudaStream_t stream) {
+#if defined(GGML_USE_HIP)
+    const char * enabled = getenv("PARACETAMOL_QWEN4EXP_MMQ_TILES");
+    if ((enabled && strcmp(enabled, "0") == 0) || a.fusion.gate || !a.ids_dst || a.nrows_x % 128 || a.ncols_max < 256 ||
+            ggml_cuda_info().devices[ctx.device].cc != GGML_CUDA_CC_OFFSET_AMD + 0x1151) return false;
+    const char * compact = getenv("PARACETAMOL_QWEN4EXP_MMQ_COMPACT");
+    // The packed descriptor reserves 16 bits for the column-tile index.
+    // Bound even the worst case where one expert receives every routed row.
+    // J32 is the smaller supported tile, so this also safely bounds J48.
+    if ((!compact || strcmp(compact, "0") != 0) && a.expert_bounds &&
+            a.nchannels_x == a.nchannels_y && a.nchannels_y >= 8 && a.nchannels_y <= MMQ_ROUTED_MAX_EXPERTS &&
+            a.nsamples_x == 1 && a.nsamples_y == 1 && a.ncols_dst <= QWEN_MMQ_MAX_ROUTED_COLS && a.ncols_dst > 0) {
+        switch (a.type_x) {
+            case GGML_TYPE_Q4_K: qwen_compact_mmq<GGML_TYPE_Q4_K, 32>(ctx, a, stream); return true;
+            case GGML_TYPE_Q8_0: qwen_compact_mmq<GGML_TYPE_Q8_0, 48>(ctx, a, stream); return true;
+            default: break;
+        }
+    }
+    switch (a.type_x) {
+        case GGML_TYPE_Q4_K: launch_mul_mat_q<GGML_TYPE_Q4_K, 32, false, GGML_PREC_Q8, false>(ctx, a, stream); return true;
+        case GGML_TYPE_Q5_1: launch_mul_mat_q<GGML_TYPE_Q5_1, 32, false, GGML_PREC_Q8, false>(ctx, a, stream); return true;
+        default: break;
+    }
+#else
+    GGML_UNUSED(ctx); GGML_UNUSED(a); GGML_UNUSED(stream);
+#endif
+    return false;
+}
diff --git a/ggml/src/ggml-cuda/qwen4exp-mmv.cu b/ggml/src/ggml-cuda/qwen4exp-mmv.cu
new file mode 100644
index 000000000..88b572ce3
--- /dev/null
+++ b/ggml/src/ggml-cuda/qwen4exp-mmv.cu
@@ -0,0 +1,185 @@
+// Q8-only extraction from halo-box/strix-llama.cpp, MIT,
+// 7a9196dad8b13b70fb3420886aadaf98fc09b849. No BF16 shadow weights or residuals.
+#include "qwen4exp-mmv.cuh"
+#include "vecdotq.cuh"
+#if defined(GGML_USE_HIP)
+
+template<int Prefetch>
+struct qwen_q8_chunk {
+    int qs[Prefetch][VDR_Q8_0_Q8_1_MMVQ];
+    half d[Prefetch];
+};
+
+template<int Prefetch>
+static __device__ __forceinline__ void qwen_q8_load(qwen_q8_chunk<Prefetch> & c,
+        const block_q8_0 * __restrict__ weights, int first, int offset, int blocks) {
+    constexpr int step = VDR_Q8_0_Q8_1_MMVQ*32/QI8_0;
+#pragma unroll
+    for (int i=0;i<Prefetch;++i) {
+        const int block=first+i*step;
+        if (block<blocks) {
+#pragma unroll
+            for (int j=0;j<VDR_Q8_0_Q8_1_MMVQ;++j) c.qs[i][j]=get_int_b2(weights[block].qs,offset+j);
+            c.d[i]=weights[block].d;
+        }
+    }
+}
+
+struct qwen_q8_group_args {
+    struct segment {
+        const block_q8_0 * weights;
+        float * output;
+        size_t stride;
+        int rows, first;
+    } segments[4];
+    int count;
+};
+
+template<int Waves, int Prefetch, bool Grouped = false>
+static __global__ __launch_bounds__(Waves*32,1) void qwen_q8_matvec(
+        const block_q8_0 * __restrict__ weights, const float * __restrict__ input,
+        float * __restrict__ output, int cols, int rows, size_t row_stride, qwen_q8_group_args group) {
+    int block_index = blockIdx.x;
+    if constexpr (Grouped) {
+        int s = 0;
+        for (int k = 1; k < 4; ++k) if (k < group.count && block_index >= group.segments[k].first) s = k;
+        const auto seg = group.segments[s];
+        weights = seg.weights; output = seg.output; rows = seg.rows; row_stride = seg.stride;
+        block_index -= seg.first;
+    }
+    const int lane=threadIdx.x, tid=threadIdx.y*32+lane;
+    const int row=block_index*Waves+threadIdx.y;
+    const int blocks=cols/QK8_0;
+    constexpr int vdr=VDR_Q8_0_Q8_1_MMVQ, step=vdr*32/QI8_0;
+    const int first=lane/(QI8_0/vdr), offset=vdr*(lane%(QI8_0/vdr));
+    // Incomplete final row groups must still reach the shared-memory barrier.
+    const auto * w=weights+size_t(row<rows ? row : rows-1)*row_stride;
+    qwen_q8_chunk<Prefetch> current;
+    qwen_q8_load(current,w,first,offset,blocks);
+    extern __shared__ char storage[];
+    auto * activation=(block_q8_1 *)storage;
+    for (int i=tid;i<4*blocks;i+=Waves*32) {
+        const int block=i/4, part=i%4;
+        const auto * packed_input = (const float4 *)(input + block*32 + part*8);
+        const float4 low = packed_input[0], high = packed_input[1];
+        const float values[8] = { low.x, low.y, low.z, low.w, high.x, high.y, high.z, high.w };
+        float maximum=fabsf(values[0]);
+#pragma unroll
+        for (int j=1;j<8;++j) maximum=fmaxf(maximum,fabsf(values[j]));
+        maximum=fmaxf(maximum,__shfl_xor_sync(0xffffffff,maximum,1,32));
+        maximum=fmaxf(maximum,__shfl_xor_sync(0xffffffff,maximum,2,32));
+        const float d=maximum/127.0f;
+        unsigned q[8];
+#pragma unroll
+        for (int j=0;j<8;++j) q[j]=unsigned(int(maximum==0.0f ? 0 : int8_t(roundf(values[j]/d))))&255;
+        auto * packed=(unsigned *)activation[block].qs;
+        packed[2*part]=q[0]|(q[1]<<8)|(q[2]<<16)|(q[3]<<24);
+        packed[2*part+1]=q[4]|(q[5]<<8)|(q[6]<<16)|(q[7]<<24);
+        if (part==0) activation[block].ds=make_half2(d,0.0f); // Q8_0 dot ignores the sum component.
+    }
+    __syncthreads();
+    if (row>=rows) return;
+    float sum=0;
+    for (int b=first;b<blocks;b+=Prefetch*step) {
+        qwen_q8_chunk<Prefetch> next;
+        if (b+Prefetch*step<blocks) qwen_q8_load(next,w,b+Prefetch*step,offset,blocks);
+#pragma unroll
+        for (int i=0;i<Prefetch;++i) if (b+i*step<blocks) {
+            const auto * a=activation+b+i*step;
+            int packed[vdr];
+#pragma unroll
+            for (int j=0;j<vdr;++j) packed[j]=get_int_b4(a->qs,offset+j);
+            sum+=vec_dot_q8_0_q8_1_impl<float,vdr>(current.qs[i],packed,current.d[i],__low2half(a->ds));
+        }
+        if (b+Prefetch*step<blocks) current=next;
+    }
+    sum=warp_reduce_sum<32>(sum);
+    if (lane==0) output[row]=sum;
+}
+
+bool ggml_cuda_qwen4exp_q8_supported(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * w, const ggml_tensor * x, const ggml_tensor * dst) {
+    const char * enabled=getenv("PARACETAMOL_QWEN4EXP_Q8_MMV");
+    if ((enabled && strcmp(enabled,"0")==0) ||
+            ggml_get_op_params_i32(dst,1)!=GGML_HINT_QWEN4EXP_Q8_DECODE ||
+            ggml_cuda_info().devices[ctx.device].cc!=GGML_CUDA_CC_OFFSET_AMD+0x1151 ||
+            w->type!=GGML_TYPE_Q8_0 || x->type!=GGML_TYPE_F32 || dst->type!=GGML_TYPE_F32 ||
+            !ggml_is_contiguous(w) || !ggml_is_contiguous(x) || !ggml_is_contiguous(dst) ||
+            uintptr_t(x->data) % alignof(float4) != 0 ||
+            w->ne[2]!=1 || w->ne[3]!=1 || x->ne[1]!=1 || x->ne[2]!=1 || x->ne[3]!=1 ||
+            dst->ne[1]!=1 || dst->ne[2]!=1 || dst->ne[3]!=1 ||
+            w->ne[0]!=x->ne[0] || dst->ne[0]!=w->ne[1] ||
+            w->ne[0]%32 || w->ne[0]<32 || w->ne[0]>14336 || w->ne[1]<1 || w->ne[1]>INT_MAX ||
+            ggml_get_op_params_i32(dst,0)!=GGML_PREC_DEFAULT ||
+            ggml_get_op_params_i32(dst,3)!=GGML_PREC_DEFAULT) return false;
+    return true;
+}
+
+bool ggml_cuda_qwen4exp_q8_matvec(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * w, const ggml_tensor * x, ggml_tensor * dst) {
+    if (!ggml_cuda_qwen4exp_q8_supported(ctx, w, x, dst)) return false;
+    const int cols=w->ne[0], rows=w->ne[1];
+    const size_t shared=(cols/32)*sizeof(block_q8_1);
+    auto launch=[&](auto kernel,int waves) {
+        kernel<<<dim3((rows+waves-1)/waves),dim3(32,waves),shared,ctx.stream()>>>(
+            (const block_q8_0 *)w->data,(const float *)x->data,(float *)dst->data,cols,rows,w->nb[1]/sizeof(block_q8_0),qwen_q8_group_args{});
+    };
+    int waves = 16;
+    while (waves > 4 && (rows + waves - 1)/waves < 2*ggml_cuda_info().devices[ctx.device].nsm) waves /= 2;
+    constexpr int step = VDR_Q8_0_Q8_1_MMVQ*32/QI8_0;
+    const bool long_rows = cols/32 >= 16*step && rows <= 1024;
+    if (waves == 16) launch(qwen_q8_matvec<16,2>,16);
+    else if (waves == 8) {
+        if (long_rows) launch(qwen_q8_matvec<8,8>,8);
+        else launch(qwen_q8_matvec<8,2>,8);
+    } else {
+        if (long_rows) launch(qwen_q8_matvec<4,8>,4);
+        else launch(qwen_q8_matvec<4,2>,4);
+    }
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
+
+// The fork's grouped matvec launch, reusing our already-tested Q8 kernel.
+// Every segment retains its own output and the same per-row dot product.
+void ggml_cuda_qwen4exp_q8_group(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes, int count) {
+    GGML_ASSERT(count >= 2 && count <= 4);
+    const auto * x = nodes[0]->src[1];
+    const int cols = x->ne[0];
+    int64_t total_rows = 0;
+    int largest = 0;
+    for (int i = 0; i < count; ++i) {
+        GGML_ASSERT(nodes[i]->src[1] == x && ggml_cuda_qwen4exp_q8_supported(ctx, nodes[i]->src[0], x, nodes[i]));
+        largest = std::max(largest, int(nodes[i]->ne[0]));
+        total_rows += nodes[i]->ne[0];
+    }
+    int waves = 16;
+    while (waves > 4 && (largest + waves-1)/waves < 2*ggml_cuda_info().devices[ctx.device].nsm) waves /= 2;
+    qwen_q8_group_args group{};
+    group.count = count;
+    int64_t blocks = 0;
+    for (int i = 0; i < count; ++i) {
+        const auto * w = nodes[i]->src[0];
+        group.segments[i] = {(const block_q8_0 *) w->data, (float *) nodes[i]->data,
+            w->nb[1]/sizeof(block_q8_0), int(w->ne[1]), int(blocks)};
+        blocks += (w->ne[1] + waves-1)/waves;
+    }
+    GGML_ASSERT(blocks <= INT_MAX);
+    const size_t shared = (cols/32)*sizeof(block_q8_1);
+    auto launch = [&](auto kernel) {
+        kernel<<<dim3(blocks),dim3(32,waves),shared,ctx.stream()>>>(
+            nullptr,(const float *)x->data,nullptr,cols,0,0,group);
+    };
+    constexpr int step = VDR_Q8_0_Q8_1_MMVQ*32/QI8_0;
+    const bool long_rows = cols/32 >= 16*step && total_rows <= 1024;
+    if (waves == 16) launch(qwen_q8_matvec<16,2,true>);
+    else if (waves == 8) {
+        if (long_rows) launch(qwen_q8_matvec<8,8,true>);
+        else launch(qwen_q8_matvec<8,2,true>);
+    } else {
+        if (long_rows) launch(qwen_q8_matvec<4,8,true>);
+        else launch(qwen_q8_matvec<4,2,true>);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+#endif
