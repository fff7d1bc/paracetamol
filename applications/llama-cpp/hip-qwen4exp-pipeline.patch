+// Four adjacent columns per thread, retaining the scalar expert accumulation
+// order. Extracted from halo-box/strix-llama.cpp 7a9196d (MIT), F32 path only.
+static __global__ void qwen_moe_reduction_v4(const float * experts, const float * scales,
+        const float * weights, float * dst, int64_t embd, int used) {
+    const int64_t token = blockIdx.x;
+    const int64_t col = 4 * ((int64_t) blockIdx.y * blockDim.x + threadIdx.x);
+    if (col >= embd) return;
+    const uint64_t first = (uint64_t) token * used;
+    const auto e = *(const float4 *) (experts + first * embd + col);
+    const float s = scales ? scales[first] : 1.0f;
+    const float w = weights[first];
+    float4 sum = make_float4((e.x*s)*w, (e.y*s)*w, (e.z*s)*w, (e.w*s)*w);
+    for (int k = 1; k < used; ++k) {
+        const uint64_t row = first + k;
+        const auto e = *(const float4 *) (experts + row * embd + col);
+        const float s = scales ? scales[row] : 1.0f;
+        const float w = weights[row];
+        sum.x += (e.x*s)*w; sum.y += (e.y*s)*w;
+        sum.z += (e.z*s)*w; sum.w += (e.w*s)*w;
+    }
+    *(float4 *) (dst + token * embd + col) = sum;
