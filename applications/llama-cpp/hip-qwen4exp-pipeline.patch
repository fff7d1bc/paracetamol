+struct test_qwen_hc_inject : public test_case {
+    int embd, tokens;
+    bool extra_reader;
+    test_qwen_hc_inject(int embd,int tokens,bool extra=false) : embd(embd),tokens(tokens),extra_reader(extra) {}
+    std::string op_desc(ggml_tensor *) override { return "QWEN_HC_INJECT"; }
+    std::string vars() override { return VARS_TO_STR3(embd,tokens,extra_reader); }
+    bool run_whole_graph() override { return true; }
+    double max_nmse_err() override { return 1e-10; }
+    double err(const float * a,const float * b,size_t n) override {
+        const size_t norm_size=size_t(embd)*4*tokens, dot_size=4*tokens;
+        if (n!=norm_size*2+dot_size*2) return nmse(a,b,n);
+        for (size_t i=0;i<norm_size*2;++i) if (a[i]!=0 || b[i]!=0) return INFINITY;
+        const double result=nmse(a+norm_size*2,a+norm_size*2+dot_size,dot_size);
+        const double ref=nmse(a+norm_size*2+dot_size,b+norm_size*2+dot_size,dot_size);
+        printf("F32-dot NMSE=%.12g reference=%.12g ",result,ref);
+        return ref>1e-10 ? INFINITY : result;
+    }
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        auto * x=ggml_new_tensor_2d(ctx,GGML_TYPE_F32,embd,tokens);
+        auto * res=ggml_new_tensor_3d(ctx,GGML_TYPE_F32,embd,4,tokens);
+        auto * weights=ggml_new_tensor_2d(ctx,GGML_TYPE_F32,4,tokens);
+        auto * gamma=ggml_new_tensor_2d(ctx,GGML_TYPE_F32,embd,4);
+        auto * projection=ggml_new_tensor_2d(ctx,GGML_TYPE_F32,embd*4,4);
+        auto branch=[&](bool marked) {
+            auto * post=ggml_dsv4_hc_post(ctx,x,res,weights,nullptr);
+            if (marked) ggml_set_name(post,"qwen4exp_hc_combine");
+            auto * rms=ggml_rms_norm(ctx,post,1e-6f);
+            auto * norm=ggml_mul(ctx,rms,gamma);
+            if (marked) ggml_set_name(norm,"qwen4exp_hc_norm");
+            auto * flat=ggml_reshape_2d(ctx,norm,embd*4,tokens);
+            auto * dot=ggml_mul_mat(ctx,projection,flat);
+            if (marked) ggml_set_name(dot,"qwen4exp_hc_inject");
+            else {
+                GGML_ASSERT(ggml_prec_set_acc(dot,GGML_PREC_F32));
+                GGML_ASSERT(ggml_prec_set_src(dot,GGML_PREC_F32,1));
+            }
+            ggml_build_forward_expand(gf,dot);
+            // The real model also sends this exact view into its HC mixer.
+            auto * view_reader=ggml_sqr(ctx,flat);
+            ggml_set_output(view_reader);
+            ggml_build_forward_expand(gf,view_reader);
+            if (extra_reader) {
+                auto * extra=ggml_sqr(ctx,rms);
+                ggml_set_output(extra);
+                ggml_build_forward_expand(gf,extra);
+            }
+            return std::array<ggml_tensor *,3>{post,norm,dot};
+        };
+        const auto a=branch(true),b=branch(false);
+        auto flatten=[&](ggml_tensor * t) { return ggml_reshape_1d(ctx,t,ggml_nelements(t)); };
+        return ggml_concat(ctx,ggml_concat(ctx,flatten(ggml_sub(ctx,a[0],b[0])),flatten(ggml_sub(ctx,a[1],b[1])),0),
+            ggml_concat(ctx,flatten(a[2]),flatten(b[2]),0),0);
+    }
+};
