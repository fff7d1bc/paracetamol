diff --git a/ggml/src/ggml-cuda/ple-conv.cu b/ggml/src/ggml-cuda/ple-conv.cu
new file mode 100644
index 000000000..6bf860419
--- /dev/null
+++ b/ggml/src/ggml-cuda/ple-conv.cu
@@ -0,0 +1,328 @@
+#include "ple-conv.cuh"
+#include "conv-tail.cuh"
+#include "unary.cuh"
+
+#if defined(__HIP_PLATFORM_AMD__)
+// the unfused graph multiplies in one kernel and adds in another: keep the two roundings apart
+static __device__ __forceinline__ float ple_mul_rn(const float a, const float b) { float r; asm("v_mul_f32_e32 %0, %1, %2" : "=v"(r) : "v"(a), "v"(b)); return r; }
+static __device__ __forceinline__ float ple_add_rn(const float a, const float b) { float r; asm("v_add_f32_e32 %0, %1, %2" : "=v"(r) : "v"(a), "v"(b)); return r; }
+#else
+static __device__ __forceinline__ float ple_mul_rn(const float a, const float b) { return __fmul_rn(a, b); }
+static __device__ __forceinline__ float ple_add_rn(const float a, const float b) { return __fadd_rn(a, b); }
+#endif
+
+// columns [tail_from, T+H) of every channel row of the concat: what the history copies read
+static __global__ void ple_concat_tail(const float * __restrict__ state, const float * __restrict__ x, float * __restrict__ out,
+                                       const int C, const int T, const int H, const int tail_from, const int row_stride) {
+    const int ncols = T + H - tail_from;
+    const int64_t idx = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= (int64_t) C * ncols) {
+        return;
+    }
+    const int c = (int) (idx / ncols), j = tail_from + (int) (idx % ncols);
+    out[(size_t) c * row_stride + j] = (j < H) ? state[c * H + j] : x[(size_t) (j - H) * C + c];
+}
+
+template <int K, int DIL, int TT>
+static __global__ void __launch_bounds__(256) ple_conv_kernel(const float * __restrict__ state, const float * __restrict__ x,
+        const float * __restrict__ w, float * __restrict__ y, const int C, const int T) {
+    constexpr int H = (K - 1) * DIL, WIN = H + 1;
+    const int c = blockIdx.x * 256 + threadIdx.x, t0 = blockIdx.y * TT;
+    if (c >= C) {
+        return;
+    }
+    float wr[K];
+#pragma unroll
+    for (int k = 0; k < K; ++k) {
+        wr[k] = w[c * K + k];
+    }
+    float win[WIN];
+    auto ld = [&](int jp) -> float {
+        return (jp < H) ? state[c * H + jp] : ((jp - H) < T ? x[(size_t) (jp - H) * C + c] : 0.0f);
+    };
+#pragma unroll
+    for (int k = 0; k < WIN; ++k) {
+        win[k] = ld(t0 + k);
+    }
+    const int tend = min(T, t0 + TT);
+    for (int t = t0; t < tend; ++t) {
+        float s = ple_mul_rn(win[0], wr[0]);
+#pragma unroll
+        for (int k = 1; k < K; ++k) {
+            s = ple_add_rn(s, ple_mul_rn(win[k * DIL], wr[k]));
+        }
+        y[(size_t) t * C + c] = ggml_cuda_op_silu_single(s);
+#pragma unroll
+        for (int k = 0; k < WIN - 1; ++k) {
+            win[k] = win[k + 1];
+        }
+        win[WIN - 1] = ld(t + WIN);
+    }
+}
+
+// tap k: CONT(TRANSPOSE(VIEW of the concat at column k*dil, [T, C]))
+static int ple_tap_index(const ggml_tensor * t, const ggml_tensor * cc, int64_t C, int64_t T, int64_t dil, int K) {
+    if (t->op != GGML_OP_CONT || !t->src[0] || t->src[0]->op != GGML_OP_TRANSPOSE || t->type != GGML_TYPE_F32 ||
+        t->ne[0] != C || t->ne[1] != T || t->ne[2] != 1 || t->ne[3] != 1 || !ggml_is_contiguous(t)) {
+        return -1;
+    }
+    const ggml_tensor * v = t->src[0]->src[0];
+    if (!v || v->op != GGML_OP_VIEW || v->view_src != cc || v->ne[0] != T || v->ne[1] != C || v->ne[2] != 1 ||
+        v->nb[1] != cc->nb[1] || v->view_offs % (dil * sizeof(float)) != 0) {
+        return -1;
+    }
+    const int64_t k = (int64_t) (v->view_offs / (dil * sizeof(float)));
+    return (k >= 0 && k < K) ? (int) k : -1;
+}
+
+// The supported GGUF has F32 convolution weights. A cast introduces separate
+// copy allocations and lifetime rules, so leave that graph to upstream.
+static const ggml_tensor * ple_weight_root(const ggml_tensor * wk, int64_t C, int k) {
+    if (wk->type != GGML_TYPE_F32 || ggml_nelements(wk) != C) {
+        return nullptr;
+    }
+    const ggml_tensor * src = wk;
+    while (src && (src->op == GGML_OP_RESHAPE || src->op == GGML_OP_VIEW)) {
+        src = src->src[0];
+    }
+    if (!src || src->op != GGML_OP_CONT) {
+        return nullptr;
+    }
+    const ggml_tensor * wv = src->src[0];
+    if (!wv || wv->op != GGML_OP_VIEW || !wv->view_src) {
+        return nullptr;
+    }
+    const ggml_tensor * W = wv->view_src;
+    if (W->type != GGML_TYPE_F32 || W->ne[1] != C || W->ne[2] != 1 || W->ne[3] != 1 ||
+        !ggml_is_contiguous(W) || wv->ne[0] != 1 || wv->ne[1] != C || wv->nb[1] != W->nb[1] ||
+        wv->view_offs != (size_t) k * ggml_element_size(W)) {
+        return nullptr;
+    }
+    return W;
+}
+
+static bool ple_conv_check(const ggml_cgraph * cgraph, int i, ggml_cuda_ple_conv_match & m) {
+    if (i < 0 || i + 2 >= cgraph->n_nodes) {
+        return ggml_cuda_conv_reject("ple_conv", "check 1", i);
+    }
+    const ggml_tensor * cc = cgraph->nodes[i];
+    if (strcmp(cc->name, "qwen4exp_ple_history") != 0 ||
+        cc->op != GGML_OP_CONCAT || cc->type != GGML_TYPE_F32 || ggml_get_op_params_i32(cc, 0) != 0 ||
+        (cc->flags & GGML_TENSOR_FLAG_OUTPUT) || !ggml_cuda_conv_next_is_noop(cgraph, i)) {
+        return ggml_cuda_conv_reject("ple_conv", "check 2", i);
+    }
+    const ggml_tensor * st = cc->src[0];
+    const ggml_tensor * tr = cc->src[1];
+    if (!st || !tr || st->type != GGML_TYPE_F32 || tr->type != GGML_TYPE_F32 || tr->op != GGML_OP_TRANSPOSE || !tr->view_src) {
+        return ggml_cuda_conv_reject("ple_conv", "check 3", i);
+    }
+    int64_t C = 0, T = 0;
+    const ggml_tensor * x = ggml_cuda_conv_activation(tr, C, T);
+    if (!x) {
+        return ggml_cuda_conv_reject("ple_conv", "check 4", i);
+    }
+    constexpr int K = 4, DIL = 3, H = (K - 1) * DIL;
+    if (st->ne[0] != H || st->ne[1] != C || st->ne[2] != 1 || st->ne[3] != 1 || !ggml_is_contiguous(st)) {
+        return ggml_cuda_conv_reject("ple_conv", "check 5", i);
+    }
+    if (tr->ne[0] != T || tr->ne[1] != C || tr->ne[2] != 1 || tr->view_offs != 0) {
+        return ggml_cuda_conv_reject("ple_conv", "check 6", i);
+    }
+    if (cc->ne[0] != T + H || cc->ne[1] != C || cc->ne[2] != 1 || cc->ne[3] != 1 || !ggml_is_contiguous(cc) || T < 256 || C % 256 != 0) {
+        return ggml_cuda_conv_reject("ple_conv", "check 7", i);
+    }
+
+    // Every later reader of the concat must be a tail reader or one of the four taps. Between the first tap and the
+    // SiLU every node must belong to the chain, because the direct kernel replaces all of them.
+    int64_t tail_from = T + H;
+    int first_tap = -1, silu = -1;
+    int n_taps = 0;
+    const ggml_tensor * tap_out[K] = { nullptr, nullptr, nullptr, nullptr }; // latest value of tap k: CONT, then its MUL
+    const ggml_tensor * W = nullptr;
+    const ggml_tensor * chain = nullptr;                                      // running ADD chain (starts at tap 0's MUL)
+    for (int n = i + 1; n < cgraph->n_nodes; ++n) {
+        const ggml_tensor * t = cgraph->nodes[n];
+        const bool reads_cc = ggml_cuda_reads(t, cc);
+        if (silu >= 0) {
+            if (reads_cc && !ggml_cuda_conv_tail_reader(t, cc, H, tail_from)) {
+                return ggml_cuda_conv_reject("ple_conv", "check 8", n);
+            }
+            continue;
+        }
+        if (reads_cc) {
+            if ((t->flags & GGML_TENSOR_FLAG_OUTPUT) && ggml_cuda_conv_tail_view_col(t, cc, H) < 0) return false;
+            const int k = ple_tap_index(t, cc, C, T, DIL, K);
+            if (k >= 0) {
+                if (tap_out[k] != nullptr) {
+                    return ggml_cuda_conv_reject("ple_conv", "check 9", n);
+                }
+                if (first_tap < 0) {
+                    first_tap = n;
+                }
+                tap_out[k] = t;
+                ++n_taps;
+                continue;
+            }
+            if (t->op == GGML_OP_VIEW || t->op == GGML_OP_TRANSPOSE) {
+                // a tap view or its transpose (no-ops), or a tail view
+                if (t->op == GGML_OP_VIEW && ggml_cuda_conv_tail_view_col(t, cc, H) >= 0) {
+                    tail_from = std::min(tail_from, ggml_cuda_conv_tail_view_col(t, cc, H));
+                    continue;
+                }
+                if (t->op == GGML_OP_VIEW && t->ne[0] == T && t->ne[1] == C && t->nb[1] == cc->nb[1] && t->view_offs % (DIL * sizeof(float)) == 0 && (int64_t) (t->view_offs / (DIL * sizeof(float))) < K) {
+                    continue;
+                }
+                if (t->op == GGML_OP_TRANSPOSE && t->src[0] && t->src[0]->op == GGML_OP_VIEW && t->src[0]->view_src == cc && t->src[0]->ne[0] == T) {
+                    continue;
+                }
+                return ggml_cuda_conv_reject("ple_conv", "check 10", n);
+            }
+            if (first_tap >= 0) {
+                return false; // a tail CONT/CPY inside the chain window would be skipped with it
+            }
+            if (!ggml_cuda_conv_tail_reader(t, cc, H, tail_from)) {
+                return ggml_cuda_conv_reject("ple_conv", "check 11", n);
+            }
+            continue;
+        }
+        if (first_tap < 0) {
+            continue; // unrelated work before the chain is computed normally
+        }
+        // inside the chain window: only the chain's own nodes
+        if (t->op == GGML_OP_MUL) {
+            const ggml_tensor * a = t->src[0];
+            const ggml_tensor * b = t->src[1];
+            int k = -1;
+            for (int q = 0; q < K; ++q) {
+                if (tap_out[q] && tap_out[q]->op == GGML_OP_CONT && (tap_out[q] == a || tap_out[q] == b)) {
+                    k = q;
+                }
+            }
+            if (k < 0 || t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) || t->ne[0] != C || t->ne[1] != T || t->ne[2] != 1) {
+                return ggml_cuda_conv_reject("ple_conv", "check 12", n);
+            }
+            const ggml_tensor * Wk = ple_weight_root(tap_out[k] == a ? b : a, C, k);
+            if (!Wk || (W && W != Wk)) {
+                return ggml_cuda_conv_reject("ple_conv", "check 13", n);
+            }
+            W = Wk;
+            tap_out[k] = t;
+            if (k == 0) {
+                chain = t;
+            }
+            continue;
+        }
+        if (t->op == GGML_OP_ADD) {
+            if (!chain || t->src[0] != chain || t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t)) {
+                return ggml_cuda_conv_reject("ple_conv", "check 14", n);
+            }
+            int k = -1;
+            for (int q = 1; q < K; ++q) {
+                if (tap_out[q] && tap_out[q]->op == GGML_OP_MUL && tap_out[q] == t->src[1]) {
+                    k = q;
+                }
+            }
+            if (k < 0) {
+                return ggml_cuda_conv_reject("ple_conv", "check 15", n);
+            }
+            tap_out[k] = t; // consumed
+            chain = t;
+            continue;
+        }
+        if (t->op == GGML_OP_UNARY && ggml_get_unary_op(t) == GGML_UNARY_OP_SILU && chain && t->src[0] == chain) {
+            if (n_taps != K || !W || t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) || t->ne[0] != C || t->ne[1] != T) {
+                return ggml_cuda_conv_reject("ple_conv", "check 16", n);
+            }
+            silu = n;
+            continue;
+        }
+        if (t->op == GGML_OP_CONT || t->op == GGML_OP_RESHAPE || t->op == GGML_OP_VIEW || t->op == GGML_OP_CPY) {
+            // weight column plumbing: must not read the concat (checked above) and must lead to a tap MUL
+            continue;
+        }
+        return ggml_cuda_conv_reject("ple_conv", "check 17", n);
+    }
+    if (silu < 0 || first_tap < 0 || n_taps != K || !W) {
+        return ggml_cuda_conv_reject("ple_conv", "check 18", i);
+    }
+    // chain intermediates feed only the chain: the direct kernel never produces them
+    for (int n = first_tap; n < silu; ++n) {
+        const ggml_tensor * t = cgraph->nodes[n];
+        if (t->op == GGML_OP_CONT || t->op == GGML_OP_MUL || t->op == GGML_OP_ADD || t->op == GGML_OP_CPY) {
+            if ((t->flags & GGML_TENSOR_FLAG_OUTPUT) || ggml_cuda_conv_readers(cgraph, n + 1, t, nullptr) != 1) {
+                return ggml_cuda_conv_reject("ple_conv", "chain intermediate has another reader", n);
+            }
+        }
+    }
+    m.concat_idx = i; m.first_tap_idx = first_tap; m.silu_idx = silu;
+    std::vector<int> indices;
+    std::vector<ggml_op> ops;
+    for (int n = first_tap; n <= silu; ++n) {
+        const auto * node = cgraph->nodes[n];
+        // Tap and weight views remain views of external inputs. Neither
+        // computes storage. The concat audit checks its consumers, while W
+        // remains live until the fused output through an allocation dependency.
+        if ((node->view_src == cc || node->view_src == W) && (node->op == GGML_OP_VIEW || node->op == GGML_OP_TRANSPOSE ||
+                node->op == GGML_OP_RESHAPE || node->op == GGML_OP_PERMUTE)) continue;
+        indices.push_back(n);
+        ops.push_back(node->op);
+    }
+    if (!ggml_can_fuse_subgraph_ext(cgraph, indices.data(), indices.size(), ops.data(), &silu, 1)) {
+        return ggml_cuda_conv_reject("ple_conv", "closure", i);
+    }
+    auto overlap = [](const ggml_tensor * a, const ggml_tensor * b) {
+        if (!a->data || !b->data) return false;
+        const uintptr_t av = (uintptr_t) a->data, bv = (uintptr_t) b->data;
+        return av <= bv ? bv-av < ggml_nbytes(a) : av-bv < ggml_nbytes(b);
+    };
+    for (const auto * input : {x, st, W}) {
+        if (overlap(input, cc) || overlap(input, cgraph->nodes[silu]) ||
+                !ggml_cuda_conv_input_untouched(cgraph, i+1, silu, input)) return false;
+    }
+    m.x = x; m.state = st; m.concat = cc; m.w = W; m.out = cgraph->nodes[silu];
+    m.C = C; m.T = T; m.H = H; m.K = K; m.dil = DIL; m.tail_from = std::max<int64_t>(0, tail_from);
+    return true;
+}
+
+bool ggml_cuda_ple_conv_match_at_concat(const ggml_cgraph * cgraph, int i, ggml_cuda_ple_conv_match & m) {
+    return ple_conv_check(cgraph, i, m);
+}
+
+bool ggml_cuda_ple_conv_match_at_tap(const ggml_cgraph * cgraph, int i, ggml_cuda_ple_conv_match & m) {
+    const ggml_tensor * t = cgraph->nodes[i];
+    if (t->op != GGML_OP_CONT || !t->src[0] || t->src[0]->op != GGML_OP_TRANSPOSE || !t->src[0]->src[0] ||
+        t->src[0]->src[0]->op != GGML_OP_VIEW || !t->src[0]->src[0]->view_src) {
+        return false;
+    }
+    const ggml_tensor * cc = t->src[0]->src[0]->view_src;
+    if (cc->op != GGML_OP_CONCAT) {
+        return false;
+    }
+    for (int c = i - 1; c >= 0; --c) {
+        if (cgraph->nodes[c] == cc) {
+            return ple_conv_check(cgraph, c, m) && m.first_tap_idx == i;
+        }
+    }
+    return false;
+}
+
+void ggml_cuda_ple_conv_write_tail(ggml_backend_cuda_context & ctx, const ggml_cuda_ple_conv_match & m) {
+    const int ncols = (int) (m.T + m.H - m.tail_from);
+    if (ncols <= 0) {
+        return;
+    }
+    const int64_t n = m.C * ncols;
+    ple_concat_tail<<<(unsigned) ((n + 255) / 256), 256, 0, ctx.stream()>>>((const float *) m.state->data, (const float *) m.x->data,
+        (float *) m.concat->data, (int) m.C, (int) m.T, (int) m.H, (int) m.tail_from, (int) (m.concat->nb[1] / sizeof(float)));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void ggml_cuda_ple_conv_direct(ggml_backend_cuda_context & ctx, const ggml_cuda_ple_conv_match & m) {
+    constexpr int TT = 128;
+    GGML_ASSERT(m.K == 4 && m.dil == 3);
+    dim3 grid((unsigned) (m.C / 256), (unsigned) ((m.T + TT - 1) / TT));
+    GGML_ASSERT(m.w->type == GGML_TYPE_F32);
+    ple_conv_kernel<4, 3, TT><<<grid, 256, 0, ctx.stream()>>>((const float *) m.state->data, (const float *) m.x->data,
+        (const float *) m.w->data, (float *) m.out->data, (int) m.C, (int) m.T);
+    CUDA_CHECK(cudaGetLastError());
+}
diff --git a/ggml/src/ggml-cuda/ple-conv.cuh b/ggml/src/ggml-cuda/ple-conv.cuh
new file mode 100644
index 000000000..c58cd0d4a
--- /dev/null
+++ b/ggml/src/ggml-cuda/ple-conv.cuh
@@ -0,0 +1,19 @@
+#pragma once
+#include "common.cuh"
+
+// qwen4exp PLE convolution: concat(history, x^T) -> four dilated taps (CONT of transposed views) x F32 weight
+// columns -> ADD chain -> SiLU. On a match the concat writes only the columns its tail copies read and one
+// kernel computes the SiLU output straight from the history and x.
+struct ggml_cuda_ple_conv_match {
+    int concat_idx = -1, first_tap_idx = -1, silu_idx = -1;
+    const ggml_tensor * x = nullptr;       // [C, T] F32 contiguous
+    const ggml_tensor * state = nullptr;   // [H, C] F32 contiguous, H = (K-1)*dil
+    const ggml_tensor * concat = nullptr;  // [T+H, C]
+    const ggml_tensor * w = nullptr;       // [K, C] F32
+    ggml_tensor * out = nullptr;           // SiLU output [C, T]
+    int64_t C = 0, T = 0, H = 0, K = 0, dil = 0, tail_from = 0;
+};
+bool ggml_cuda_ple_conv_match_at_concat(const ggml_cgraph * cgraph, int i, ggml_cuda_ple_conv_match & m);
+bool ggml_cuda_ple_conv_match_at_tap(const ggml_cgraph * cgraph, int i, ggml_cuda_ple_conv_match & m);
+void ggml_cuda_ple_conv_write_tail(ggml_backend_cuda_context & ctx, const ggml_cuda_ple_conv_match & m);
+void ggml_cuda_ple_conv_direct(ggml_backend_cuda_context & ctx, const ggml_cuda_ple_conv_match & m);
diff --git a/ggml/src/ggml-cuda/qwen4exp-hc.cu b/ggml/src/ggml-cuda/qwen4exp-hc.cu
new file mode 100644
index 000000000..698473a60
--- /dev/null
+++ b/ggml/src/ggml-cuda/qwen4exp-hc.cu
@@ -0,0 +1,207 @@
+#include "qwen4exp-hc.cuh"
+#include "ggml-backend-impl.h"
+
+// Adapt the Strix fork's combined residual/RMS operation to upstream's HC_POST
+// node. Match upstream's aligned float4 F32 RMS reduction. Zero virtual lanes
+// retain the same tree for 256/512-thread rows as for a 1024-thread row.
+template <int BLOCK>
+static __global__ void qwen_hc_norm_kernel(const float * x, const float * residual,
+        const float * weights, const float * gamma, float * post, float * norm,
+        int embd, int streams, float eps) {
+    const int stream = blockIdx.x, token = blockIdx.y, tid = threadIdx.x;
+    const int64_t row = (int64_t) token * streams + stream;
+    const float w = weights[row];
+    // Virtual groups retain the upstream tree with fewer physical threads.
+    constexpr int GROUPS = 1024/BLOCK;
+    float values[GROUPS][4] = {};
+    __shared__ float partial[32];
+#pragma unroll
+    for (int group = 0; group < GROUPS; ++group) {
+        float sum = 0.0f;
+#pragma unroll
+        for (int k = 0; k < 4; ++k) {
+            const int col = 4*(tid + group*BLOCK) + k;
+            if (col < embd) {
+                float value = x[(int64_t) token*embd + col] * w;
+                value += residual[row*embd + col];
+                values[group][k] = value;
+                post[row*embd + col] = value;
+            }
+        }
+        const float * v = values[group];
+        sum = v[0]*v[0] + v[1]*v[1] + v[2]*v[2] + v[3]*v[3];
+        sum = warp_reduce_sum(sum);
+        if (tid % 32 == 0) partial[group*(BLOCK/32) + tid/32] = sum;
+    }
+    __syncthreads();
+    const float sum = warp_reduce_sum(partial[tid%32]);
+    const float scale = rsqrtf(sum/embd + eps);
+#pragma unroll
+    for (int group = 0; group < GROUPS; ++group) {
+#pragma unroll
+        for (int k = 0; k < 4; ++k) {
+            const int col = 4*(tid + group*BLOCK) + k;
+            if (col < embd) norm[row*embd + col] = scale*values[group][k]*gamma[stream*embd + col];
+        }
+    }
+}
+
+// F32-only version of the fork's norm/injection fusion. Normalized residual
+// values retain upstream's float4 RMS tree. The four dot products use an ordinary
+// parallel F32 reduction, not a rounded F16/BF16 matrix path.
+static __global__ void qwen_hc_norm_inject_kernel(const float * x, const float * residual,
+        const float * weights, const float * gamma, const float * projection,
+        float * post, float * norm, float * inject, int embd, float eps) {
+    const int token=blockIdx.x, tid=threadIdx.x;
+    __shared__ float partial[32];
+    __shared__ float dot_partial[4][8];
+    float dot[4]={};
+    for (int stream=0;stream<4;++stream) {
+        const int64_t row=int64_t(token)*4+stream;
+        const float w=weights[row];
+        float values[4][4]={};
+#pragma unroll
+        for (int group=0;group<4;++group) {
+            float sum=0;
+#pragma unroll
+            for (int k=0;k<4;++k) {
+                const int col=4*(tid+group*256)+k;
+                if (col<embd) {
+                    float v=x[int64_t(token)*embd+col]*w;
+                    v+=residual[row*embd+col];
+                    post[row*embd+col]=v;
+                    values[group][k]=v;
+                }
+            }
+            const float * v=values[group];
+            sum=v[0]*v[0]+v[1]*v[1]+v[2]*v[2]+v[3]*v[3];
+            sum=warp_reduce_sum(sum);
+            if (tid%32==0) partial[group*8+tid/32]=sum;
+        }
+        __syncthreads();
+        const float sum=warp_reduce_sum(partial[tid%32]);
+        const float scale=rsqrtf(sum/embd+eps);
+#pragma unroll
+        for (int group=0;group<4;++group) {
+#pragma unroll
+            for (int k=0;k<4;++k) {
+                const int col=4*(tid+group*256)+k;
+                if (col<embd) {
+                    const float v=scale*values[group][k]*gamma[stream*embd+col];
+                    norm[row*embd+col]=v;
+#pragma unroll
+                    for (int r=0;r<4;++r) dot[r]+=v*projection[(r*4+stream)*embd+col];
+                }
+            }
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for (int r=0;r<4;++r) {
+        const float sum=warp_reduce_sum(dot[r]);
+        if (tid%32==0) dot_partial[r][tid/32]=sum;
+    }
+    __syncthreads();
+    if (tid<4) {
+        float sum=0;
+#pragma unroll
+        for (int wave=0;wave<8;++wave) sum+=dot_partial[tid][wave];
+        inject[int64_t(token)*4+tid]=sum;
+    }
+}
+
+bool qwen_hc_match_at(const ggml_cgraph * graph, int i, qwen_hc_match & m, bool aliases) {
+    if (i+2 >= graph->n_nodes) return false;
+    auto * post = graph->nodes[i];
+    auto * rms = graph->nodes[i+1];
+    auto * mul = graph->nodes[i+2];
+    if (post->op != GGML_OP_DSV4_HC_POST || strcmp(mul->name, "qwen4exp_hc_norm") != 0 ||
+            post->src[3] || rms->op != GGML_OP_RMS_NORM || rms->src[0] != post || mul->op != GGML_OP_MUL ||
+            mul->src[0] != rms || post->ne[0] < 1024 || post->ne[0] > 3072 || post->ne[0] % 4 != 0 ||
+            post->ne[1] != 4 || post->ne[2] > 65535 || post->ne[3] != 1) return false;
+    const auto * x = post->src[0], * res = post->src[1], * w = post->src[2], * gamma = mul->src[1];
+    for (const auto * t : {x, res, w, gamma, (const ggml_tensor *) post, (const ggml_tensor *) rms, (const ggml_tensor *) mul}) {
+        if (!t || t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t)) return false;
+    }
+    const int64_t embd = post->ne[0], tokens = post->ne[2];
+    if (!ggml_are_same_shape(res, post) || !ggml_are_same_shape(rms, post) || !ggml_are_same_shape(mul, post) ||
+            x->ne[0] != embd || x->ne[1] != tokens || x->ne[2] != 1 || x->ne[3] != 1 ||
+            w->ne[0] != 4 || w->ne[1] != tokens || w->ne[2] != 1 || w->ne[3] != 1 ||
+            gamma->ne[0] != embd || gamma->ne[1] != 4 || gamma->ne[2] != 1 || gamma->ne[3] != 1 ||
+            !ggml_can_fuse_subgraph(graph, i, {GGML_OP_DSV4_HC_POST, GGML_OP_RMS_NORM, GGML_OP_MUL}, {i, i+2})) return false;
+    if (aliases) {
+        // Otherwise upstream would select a different scalar reduction.
+        for (const auto * t : std::initializer_list<const ggml_tensor *>{post, rms, mul, gamma}) {
+            if (!ggml_cuda_is_aligned(t, 16)) return false;
+        }
+        auto overlap = [](const ggml_tensor * a, const ggml_tensor * b) {
+            const uintptr_t av = (uintptr_t) a->data, bv = (uintptr_t) b->data;
+            return av <= bv ? bv-av < ggml_nbytes(a) : av-bv < ggml_nbytes(b);
+        };
+        for (const auto * input : {x, w, gamma}) {
+            if (overlap(input, post) || overlap(input, mul)) return false;
+        }
+        if (overlap(post, mul) || overlap(res, mul) ||
+                (overlap(res, post) && res->data != post->data)) return false;
+    }
+    m.post = post; m.norm = mul; m.gamma = gamma; m.inject = nullptr;
+    memcpy(&m.eps, rms->op_params, sizeof(float));
+    return true;
+}
+
+bool qwen_hc_inject_match_at(const ggml_cgraph * graph, int i, qwen_hc_match & m, bool aliases) {
+    const char * enabled=getenv("PARACETAMOL_QWEN4EXP_HC_INJECT");
+    if ((enabled && strcmp(enabled,"0")==0) || i+4>=graph->n_nodes || !qwen_hc_match_at(graph,i,m,aliases)) return false;
+    auto * view=graph->nodes[i+3];
+    auto * mm=graph->nodes[i+4];
+    const auto * w=mm->src[0];
+    const int64_t embd=m.post->ne[0], tokens=m.post->ne[2];
+    if (tokens<256 || view->op!=GGML_OP_RESHAPE || view->src[0]!=m.norm ||
+            view->ne[0]!=embd*4 || view->ne[1]!=tokens || view->ne[2]!=1 || view->ne[3]!=1 || !ggml_is_contiguous(view) ||
+            mm->op!=GGML_OP_MUL_MAT || strcmp(mm->name,"qwen4exp_hc_inject") ||
+            mm->src[1]!=view || !w || w->type!=GGML_TYPE_F32 || !ggml_is_contiguous(w) ||
+            w->ne[0]!=embd*4 || w->ne[1]!=4 || w->ne[2]!=1 || w->ne[3]!=1 ||
+            mm->type!=GGML_TYPE_F32 || !ggml_is_contiguous(mm) ||
+            mm->ne[0]!=4 || mm->ne[1]!=tokens || mm->ne[2]!=1 || mm->ne[3]!=1 ||
+            mm->op_params[0]!=GGML_PREC_DEFAULT || mm->op_params[3]!=GGML_PREC_DEFAULT ||
+            !ggml_can_fuse_subgraph(graph,i,{GGML_OP_DSV4_HC_POST,GGML_OP_RMS_NORM,GGML_OP_MUL,
+                GGML_OP_RESHAPE,GGML_OP_MUL_MAT},{i,i+2,i+3,i+4})) return false;
+    if (aliases) {
+        auto overlap=[](const ggml_tensor * a,const ggml_tensor * b) {
+            if (!a->data || !b->data) return false;
+            const uintptr_t x=uintptr_t(a->data),y=uintptr_t(b->data);
+            return x<=y ? y-x<ggml_nbytes(a) : x-y<ggml_nbytes(b);
+        };
+        for (const auto * t : std::initializer_list<const ggml_tensor *>{m.post->src[0],m.post->src[1],m.post->src[2],m.gamma,
+                (const ggml_tensor *)m.post,(const ggml_tensor *)m.norm,w}) {
+            if (overlap(t,mm)) return false;
+        }
+        if (overlap(w,m.post) || overlap(w,m.norm)) return false;
+    }
+    m.inject=mm;
+    return true;
+}
+
+void qwen_hc_combine_norm(ggml_backend_cuda_context & ctx, const qwen_hc_match & m) {
+    const auto * p = m.post;
+    if (m.inject) {
+        qwen_hc_norm_inject_kernel<<<p->ne[2],256,0,ctx.stream()>>>(
+            (const float *)p->src[0]->data,(const float *)p->src[1]->data,(const float *)p->src[2]->data,
+            (const float *)m.gamma->data,(const float *)m.inject->src[0]->data,
+            (float *)p->data,(float *)m.norm->data,(float *)m.inject->data,p->ne[0],m.eps);
+        CUDA_CHECK(cudaGetLastError());
+        return;
+    }
+    const dim3 blocks(p->ne[1], p->ne[2]);
+    const char * packed = getenv("PARACETAMOL_QWEN4EXP_HC_PACKED");
+    if (!packed || strcmp(packed, "0") != 0) {
+        qwen_hc_norm_kernel<256><<<blocks, 256, 0, ctx.stream()>>>(
+            (const float *) p->src[0]->data, (const float *) p->src[1]->data, (const float *) p->src[2]->data,
+            (const float *) m.gamma->data, (float *) p->data, (float *) m.norm->data, p->ne[0], p->ne[1], m.eps);
+    } else {
+        qwen_hc_norm_kernel<1024><<<blocks, 1024, 0, ctx.stream()>>>(
+            (const float *) p->src[0]->data, (const float *) p->src[1]->data, (const float *) p->src[2]->data,
+            (const float *) m.gamma->data, (float *) p->data, (float *) m.norm->data, p->ne[0], p->ne[1], m.eps);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
