+struct test_qwen_narrow_norm : public test_case {
+    int cols, rows;
+    bool gated, strided, extra_reader;
+    test_qwen_narrow_norm(int cols, int rows, bool gated, bool strided = false, bool extra_reader = false)
+        : cols(cols), rows(rows), gated(gated), strided(strided), extra_reader(extra_reader) {}
+    std::string op_desc(ggml_tensor *) override { return "QWEN_NARROW_NORM"; }
+    std::string vars() override { return VARS_TO_STR5(cols, rows, gated, strided, extra_reader); }
+    bool run_whole_graph() override { return true; }
+    double max_nmse_err() override { return 0; }
+    double err(const float * actual, const float *, size_t n) override {
+        for (size_t i = 0; i < n; ++i) if (actual[i] != 0.0f) return INFINITY;
+        return 0;
+    }
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        auto * base = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, cols + (strided ? 32 : 0), rows);
+        auto * x = strided ? ggml_view_2d(ctx, base, cols, rows, base->nb[1], 0) : base;
+        auto * w = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, cols);
+        auto * z = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, cols, rows);
+        auto branch = [&](bool marked) {
+            auto * norm = ggml_rms_norm(ctx, x, 1e-6f);
+            if (marked) ggml_set_name(norm, "qwen4exp_narrow_norm");
+            auto * out = ggml_mul(ctx, norm, w);
+            if (gated) out = ggml_mul(ctx, out, ggml_sigmoid(ctx, z));
+            if (extra_reader) out = ggml_concat(ctx, out, ggml_sqr(ctx, norm), 1);
+            return out;
+        };
+        auto * fast = branch(true);
+        auto * original = branch(false);
+        return ggml_sub(ctx, fast, original);
+    }
+};
