+    double err(const float * actual, const float *, size_t n) override {
+        for (size_t i = 0; i < n; ++i) if (actual[i] != 0.0f) return INFINITY;
+        return 0;
+    }
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        auto * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, channels, tokens);
+        auto * state = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 3, channels);
+        auto * w = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 4, channels);
+        auto branch = [&](bool marked) {
+            auto * history = mutate_state ? ggml_cpy(ctx, state, ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 3, channels)) : state;
+            auto * cc = ggml_concat(ctx, history, ggml_transpose(ctx, x), 0);
+            if (marked) ggml_set_name(cc, "qwen4exp_gdn_history");
+            ggml_tensor * histories = nullptr;
+            for (int s = 0; s < slots; ++s) {
+                auto * tail = ggml_cont(ctx, ggml_view_2d(ctx, cc, 3, channels, cc->nb[1],
+                    std::max(0, tokens-s) * sizeof(float)));
+                ggml_build_forward_expand(gf, tail);
+                auto * flat = ggml_reshape_1d(ctx, tail, 3*channels);
+                histories = histories ? ggml_concat(ctx, histories, flat, 0) : flat;
+            }
+            if (mutate_state) {
+                auto * tail = ggml_cont(ctx, ggml_view_2d(ctx, cc, 3, channels, cc->nb[1], tokens*sizeof(float)));
+                ggml_build_forward_expand(gf, ggml_cpy(ctx, tail, history));
+            }
+            auto * out = ggml_silu(ctx, ggml_ssm_conv(ctx, cc, w));
+            auto * flat = ggml_reshape_1d(ctx, out, channels*tokens);
+            auto * combined = ggml_concat(ctx, flat, histories, 0);
+            if (extra_reader) {
+                // A whole-concat consumer must retain full materialization.
+                auto * all = ggml_reshape_1d(ctx, ggml_sqr(ctx, cc), ggml_nelements(cc));
+                combined = ggml_concat(ctx, combined, all, 0);
+            }
+            return combined;
+        };
+        auto * fast = branch(true);
+        auto * original = branch(false);
+        return ggml_sub(ctx, fast, original);
+    }
