+struct test_qwen_ple_conv : public test_case {
+    ggml_type type;
+    int channels, tokens, slots;
+    bool extra_reader, mutate_state;
+    test_qwen_ple_conv(ggml_type type, int channels, int tokens, int slots, bool extra_reader = false, bool mutate_state = false)
+        : type(type), channels(channels), tokens(tokens), slots(slots), extra_reader(extra_reader), mutate_state(mutate_state) {}
+    std::string op_desc(ggml_tensor *) override { return mutate_state ? "QWEN_PLE_CONV_MUTATION" : "QWEN_PLE_CONV"; }
+    std::string vars() override { return VARS_TO_STR6(type, channels, tokens, slots, extra_reader, mutate_state); }
+    bool run_whole_graph() override { return true; }
+    double max_nmse_err() override { return 0; }
+    double err(const float * actual, const float *, size_t n) override {
+        for (size_t i = 0; i < n; ++i) if (actual[i] != 0.0f) return INFINITY;
+        return 0;
+    }
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        auto * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, channels, tokens);
+        auto * state = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 9, channels);
+        auto * weights = ggml_new_tensor_2d(ctx, type, 4, channels);
+        auto branch = [&](bool marked) {
+            auto * history = mutate_state ? ggml_cpy(ctx, state, ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 9, channels)) : state;
+            auto * cc = ggml_concat(ctx, history, ggml_transpose(ctx, x), 0);
+            if (marked) ggml_set_name(cc, "qwen4exp_ple_history");
+            ggml_tensor * histories = nullptr;
+            for (int s = 0; s < slots; ++s) {
+                auto * tail = ggml_cont(ctx, ggml_view_2d(ctx, cc, 9, channels, cc->nb[1],
+                    std::max(0, tokens-s) * sizeof(float)));
+                ggml_build_forward_expand(gf, tail);
+                auto * flat = ggml_reshape_1d(ctx, tail, 9*channels);
+                histories = histories ? ggml_concat(ctx, histories, flat, 0) : flat;
+            }
+            if (mutate_state) {
+                auto * tail = ggml_cont(ctx, ggml_view_2d(ctx, cc, 9, channels, cc->nb[1], tokens*sizeof(float)));
+                ggml_build_forward_expand(gf, ggml_cpy(ctx, tail, history));
+            }
+            ggml_tensor * out = nullptr;
+            for (int k = 0; k < 4; ++k) {
+                auto * shifted = ggml_cont(ctx, ggml_transpose(ctx,
+                    ggml_view_2d(ctx, cc, tokens, channels, cc->nb[1], k*3*sizeof(float))));
+                auto * wk = ggml_cont(ctx, ggml_view_2d(ctx, weights, 1, channels, weights->nb[1], k*weights->nb[0]));
+                wk = ggml_reshape_1d(ctx, wk, channels);
+                if (wk->type != GGML_TYPE_F32) wk = ggml_cast(ctx, wk, GGML_TYPE_F32);
+                auto * term = ggml_mul(ctx, shifted, wk);
+                out = out ? ggml_add(ctx, out, term) : term;
+            }
+            out = ggml_silu(ctx, out);
+            auto * combined = ggml_concat(ctx, ggml_reshape_1d(ctx, out, channels*tokens), histories, 0);
+            if (extra_reader) combined = ggml_concat(ctx, combined,
+                ggml_reshape_1d(ctx, ggml_sqr(ctx, cc), ggml_nelements(cc)), 0);
+            return combined;
+        };
+        auto * fast = branch(true);
+        auto * original = branch(false);
+        return ggml_sub(ctx, fast, original);
+    }
+};
