+bool ggml_cuda_qwen_mm_ids(ggml_backend_cuda_context & ctx,
+        const int32_t * ids, int32_t * src, int32_t * dst, int32_t * bounds,
+        int experts, int tokens, int used, int channels, int ids_stride, int token_stride,
+        bool inverse, cudaStream_t stream) {
+#if defined(GGML_USE_HIP)
+    const char * enabled = getenv("PARACETAMOL_QWEN4EXP_MOE_IDS");
+    if ((!enabled || strcmp(enabled, "0") != 0) &&
+            ggml_cuda_info().devices[ctx.device].cc == GGML_CUDA_CC_OFFSET_AMD + 0x1151 &&
+            experts == 512 && used == 10 && tokens >= 256 && tokens <= 4096 &&
+            (channels == 1 || channels == used) && ids_stride >= used && token_stride >= channels) {
+        mm_ids_helper_512_10<<<1, 1024, 0, stream>>>(ids, src, dst, bounds, tokens, channels, ids_stride, token_stride, inverse);
+        CUDA_CHECK(cudaGetLastError());
+        return true;
+    }
+#else
+    GGML_UNUSED(ctx); GGML_UNUSED(ids); GGML_UNUSED(src); GGML_UNUSED(dst); GGML_UNUSED(bounds);
+    GGML_UNUSED(experts); GGML_UNUSED(tokens); GGML_UNUSED(used); GGML_UNUSED(channels);
+    GGML_UNUSED(ids_stride); GGML_UNUSED(token_stride); GGML_UNUSED(inverse); GGML_UNUSED(stream);
+#endif
