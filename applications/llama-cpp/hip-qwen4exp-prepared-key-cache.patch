diff --git a/src/qwen4exp-key-cache.h b/src/qwen4exp-key-cache.h
new file mode 100644
index 000000000..6b428c66a
--- /dev/null
+++ b/src/qwen4exp-key-cache.h
@@ -0,0 +1,45 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+// Derived keys are valid only after a successful ubatch. The memory owner
+// invalidates this ledger before every cache mutation/restore. Unsupported
+// layouts rebuild normally rather than trying to repair derived state.
+struct qwen4exp_key_cache_state {
+    explicit qwen4exp_key_cache_state(size_t layers = 0) : ready(layers, -1), pending(layers) {}
+    std::vector<int64_t> ready;
+    std::vector<bool> pending;
+    int32_t sequence = -1, current_sequence = -1;
+    int64_t end = -1, current_end = -1, current_start = -1;
+    bool active = false;
+
+    void invalidate() {
+        std::fill(ready.begin(), ready.end(), -1);
+        std::fill(pending.begin(), pending.end(), false);
+        sequence = current_sequence = -1;
+        end = current_end = current_start = -1;
+        active = false;
+    }
+    void begin(int32_t seq, int64_t start, int64_t count, bool valid) {
+        if (!valid || seq < 0 || start < 0 || count < 1) { invalidate(); return; }
+        if (active || seq != sequence || start != end) invalidate();
+        std::fill(pending.begin(), pending.end(), false);
+        current_sequence = seq;
+        current_start = start;
+        current_end = start + count;
+        active = true;
+    }
+    bool fast(size_t layer) const {
+        return active && current_end - current_start == 1 && current_end / 4 > 0 &&
+            current_sequence == sequence && current_start == end && ready.at(layer) >= current_start / 4;
+    }
+    void mark(size_t layer) { if (active) pending.at(layer) = true; }
+    void commit() {
+        if (!active) return;
+        for (size_t i = 0; i < ready.size(); ++i) ready[i] = pending[i] ? current_end / 4 : -1;
+        sequence = current_sequence;
+        end = current_end;
+        active = false;
+    }
+};
