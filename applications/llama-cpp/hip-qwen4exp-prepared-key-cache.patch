diff --git a/tests/test-qwen4exp-key-cache.cpp b/tests/test-qwen4exp-key-cache.cpp
new file mode 100644
index 000000000..27028f8bc
--- /dev/null
+++ b/tests/test-qwen4exp-key-cache.cpp
@@ -0,0 +1,42 @@
+#include "../src/qwen4exp-key-cache.h"
+#include <cstdio>
+#include <cstdlib>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::abort(); } } while (0)
+int main() {
+    qwen4exp_key_cache_state s(2);
+    // Prefill does not populate derived storage. The first decode does.
+    s.begin(0, 0, 4096, true); s.commit();
+    s.begin(0, 4096, 1, true); CHECK(!s.fast(0));
+    s.mark(0); s.mark(1); s.commit();
+    s.begin(0, 4097, 1, true); CHECK(s.fast(0) && s.fast(1));
+    s.invalidate();
+    s.begin(0, 0, 3, true); s.mark(0); s.commit();
+    s.begin(0, 3, 1, true); CHECK(s.fast(0) && !s.fast(1));
+    s.invalidate();
+    s.begin(0, 0, 4096, true);
+    CHECK(!s.fast(0)); s.mark(0); s.mark(1); s.commit();
+    for (int p = 4096; p < 4110; ++p) {
+        s.begin(0, p, 1, true); CHECK(s.fast(0) && s.fast(1));
+        s.mark(0); s.mark(1); s.commit();
+    }
+    // A missing layer cannot be treated as computed.
+    s.begin(0, 4110, 1, true); s.mark(0); s.commit();
+    s.begin(0, 4111, 1, true); CHECK(s.fast(0) && !s.fast(1));
+    s.invalidate(); CHECK(!s.fast(0));
+    // Cancellation after marking but before successful commit must not publish.
+    s.begin(0, 5000, 1, true); CHECK(!s.fast(0)); s.mark(0);
+    s.begin(0, 5001, 1, true); CHECK(!s.fast(0));
+    s.mark(0); s.commit();
+    // Rewinds and replacements rebuild even when the sequence ID is unchanged.
+    s.begin(0, 4000, 1, true); CHECK(!s.fast(0)); s.mark(0); s.commit();
+    s.begin(1, 4001, 1, true); CHECK(!s.fast(0)); s.mark(0); s.commit();
+    s.begin(1, 4002, 1, false); CHECK(!s.fast(0));
+    // A full prefill re-establishes the cache after invalidation.
+    s.begin(2, 0, 8192, true); CHECK(!s.fast(0)); s.mark(0); s.mark(1); s.commit();
+    s.begin(2, 8192, 2, true); CHECK(!s.fast(0)); s.mark(0); s.mark(1); s.commit();
+    s.begin(2, 8194, 1, true); CHECK(s.fast(0));
+    s.invalidate(); // clear, seq_rm/cp/keep/add/div, restore, or layout update
+    s.begin(2, 8194, 1, true); CHECK(!s.fast(0));
+    std::puts("Qwen4exp prepared-key cache ledger passed");
+}
