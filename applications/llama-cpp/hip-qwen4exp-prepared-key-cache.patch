+    }
+    bool can_reuse(const llm_graph_params & p) override {
+        mctx = static_cast<const llama_memory_hybrid_idx_context *>(p.mctx);
+        return mctx && mctx->qsa_cache_available(layer) && fast == mctx->qsa_cache_fast(layer);
+    }
+};
