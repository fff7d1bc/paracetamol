+struct test_qsa_prepared : public test_case {
+    int blocks;
+    bool tail;
+    ggml_tensor * full_ids = nullptr, * short_ids = nullptr, * full_pos = nullptr, * short_pos = nullptr, * rows = nullptr;
+    test_qsa_prepared(int blocks, bool tail) : blocks(blocks), tail(tail) {}
+    std::string op_desc(ggml_tensor *) override { return "QSA_PREPARED"; }
+    std::string vars() override { return VARS_TO_STR2(blocks, tail); }
+    bool run_whole_graph() override { return true; }
+    double max_nmse_err() override { return 0; }
+    double err(const float * actual, const float *, size_t n) override {
+        for (size_t i = 0; i < n; ++i) if (actual[i] != 0.0f) return INFINITY;
+        return 0;
+    }
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        auto * raw = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, 128, 4*blocks);
+        auto * norm = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 128);
+        full_ids = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 4*blocks);
+        short_ids = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 8);
+        full_pos = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 4*blocks);
+        short_pos = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 8);
+        rows = ggml_new_tensor_1d(ctx, GGML_TYPE_I64, 2);
+        auto prepare = [&](ggml_tensor * ids, ggml_tensor * pos, int n) {
+            auto * members = ggml_get_rows(ctx, raw, ids);
+            ggml_set_name(members, "qwen4exp_qsa_members");
+            members = ggml_reshape_4d(ctx, members, 128, 4, n, 1);
+            ggml_tensor * pooled = nullptr;
+            for (int k = 0; k < 4; ++k) {
+                auto * slice = ggml_cont(ctx, ggml_view_3d(ctx, members, 128, n, 1,
+                    members->nb[2], members->nb[3], k*members->nb[1]));
+                pooled = pooled ? ggml_add(ctx, pooled, slice) : slice;
+            }
+            pooled = ggml_scale(ctx, pooled, 0.25f);
+            pooled = ggml_reshape_3d(ctx, pooled, 128, n, 1);
+            pooled = ggml_mul(ctx, ggml_rms_norm(ctx, pooled, 1e-6f), norm);
+            pooled = ggml_reshape_3d(ctx, pooled, 128, 1, n);
+            int sections[4] = {16, 24, 24, 0};
+            pooled = ggml_rope_multi(ctx, pooled, pos, nullptr, 128, sections, GGML_ROPE_TYPE_IMROPE,
+                262144, 10000000.0f, 1.0f, 0.0f, 1.0f, 32.0f, 1.0f);
+            return ggml_reshape_2d(ctx, pooled, 128, n);
+        };
+        auto * full = prepare(full_ids, full_pos, blocks);
+        auto * short_keys = prepare(short_ids, short_pos, 2);
+        auto * storage = ggml_cont(ctx, full);
+        auto * written = ggml_set_rows(ctx, storage, short_keys, rows);
+        return ggml_sub(ctx, written, full);
+    }
+    void initialize_tensors(ggml_context * ctx) override {
+        test_case::initialize_tensors(ctx);
+        std::vector<int32_t> ids(4*blocks), pos(4*blocks), subids(8), subpos(8);
+        for (int b = 0; b < blocks; ++b) {
+            for (int k = 0; k < 4; ++k) ids[4*b+k] = 4*(blocks-1-b)+k;
+            for (int a = 0; a < 4; ++a) pos[a*blocks+b] = 4*b;
+        }
+        if (tail) {
+            std::fill(ids.end()-4, ids.end(), 0);
+            for (int a = 0; a < 4; ++a) pos[a*blocks+blocks-1] = 0;
+        }
+        std::copy_n(ids.data()+4*(blocks-2), 8, subids.data());
+        for (int a = 0; a < 4; ++a) { subpos[2*a] = 4*(blocks-2); subpos[2*a+1] = tail ? 0 : 4*(blocks-1); }
+        int64_t r[2] = {blocks-2, blocks-1};
+        ggml_backend_tensor_set(full_ids, ids.data(), 0, ggml_nbytes(full_ids));
+        ggml_backend_tensor_set(short_ids, subids.data(), 0, ggml_nbytes(short_ids));
+        ggml_backend_tensor_set(full_pos, pos.data(), 0, ggml_nbytes(full_pos));
+        ggml_backend_tensor_set(short_pos, subpos.data(), 0, ggml_nbytes(short_pos));
+        ggml_backend_tensor_set(rows, r, 0, sizeof(r));
+    }
+};
