+        {"{\"type\":\"object\"}", "{\"x\": [2, false]}", "{\"x\":[2,false]}"},
+        {"{\"type\":\"string\"}", "001", "\"001\""},
+        {"{\"type\":\"string\"}", "40", "\"40\""},
+        {"{\"type\":\"string\"}", "true", "\"true\""},
