+        {"{\"type\":\"integer\"}", "001", "\"001\""},
+        {"{\"type\":\"integer\"}", "1.5", "\"1.5\""},
+        {"{\"type\":\"number\"}", "+1", "\"+1\""},
+        {"{\"type\":\"number\"}", "0x10", "\"0x10\""},
+        {"{\"type\":\"number\"}", "NaN", "\"NaN\""},
+        {"{\"type\":\"number\"}", "Infinity", "\"Infinity\""},
+        {"{\"type\":\"number\"}", "1.", "\"1.\""},
+        {"{\"type\":\"number\"}", "1e", "\"1e\""},
+        {"{\"type\":\"boolean\"}", "True", "\"True\""},
